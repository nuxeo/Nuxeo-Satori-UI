{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nuxeo-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/nuxeo-ui",
      "sourceRoot": "apps/nuxeo-ui/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/nuxeo-ui/src/main.ts",
            "index": "apps/nuxeo-ui/src/index.html",
            "tsConfig": "apps/nuxeo-ui/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/nuxeo-ui",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/nuxeo-ui/public",
                "ignore": ["i18n/*.context.json"]
              },
              {
                "glob": "**/*",
                "input": "node_modules/@hylandsoftware/satori-ui/i18n",
                "output": "assets/satori-ui/i18n"
              }
            ],
            "styles": ["apps/nuxeo-ui/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "36kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "apps/nuxeo-ui/public",
                  "ignore": ["i18n/*.context.json"]
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/@hylandsoftware/satori-ui/i18n",
                  "output": "assets/satori-ui/i18n"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/nuxeo-ui/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "nuxeo-ui:build:production"
            },
            "development": {
              "buildTarget": "nuxeo-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "apps/nuxeo-ui/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/nuxeo-ui/public"
              }
            ],
            "styles": ["apps/nuxeo-ui/src/styles.scss"],
            "karmaConfig": "apps/nuxeo-ui/karma.conf.js"
          }
        }
      }
    },
    "nuxeo-satori-template": {
      "projectType": "application",
      "root": "apps/nuxeo-satori-template",
      "sourceRoot": "apps/nuxeo-satori-template/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/nuxeo-satori-template/src/main.ts",
            "index": "apps/nuxeo-satori-template/src/index.html",
            "tsConfig": "apps/nuxeo-satori-template/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/nuxeo-satori-template",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/nuxeo-satori-template/public"
              }
            ],
            "styles": ["apps/nuxeo-satori-template/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "450kb",
                  "maximumError": "700kb"
                }
              ],
              "outputHashing": "all",
              "optimization": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/nuxeo-satori-template/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "nuxeo-satori-template:build:production"
            },
            "development": {
              "buildTarget": "nuxeo-satori-template:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "37bac9db-cc12-46eb-8b2b-8fd5b8920b46"
  }
}
