{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/nuxeo-ui-e2e",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "sourceMap": false,
    // So `src/fixtures.ts` can import the identity guard both harness sides share
    // (`scripts/beta-harness/identity-guard.mjs`, NXSAT-643) instead of keeping a TypeScript copy
    // of a security check. Its JSDoc types are enforced where it is `checkJs`'d: `a11y/`.
    "allowJs": true,
    // `@playwright/test` is installed with `--no-save`, so on a machine that has not run
    // that install its types are absent and every spec would report TS2307. That is an
    // environment fact, not a code defect, and failing the repo-wide typecheck on it would
    // make a green tree depend on an untracked dependency. `e2e-preflight.mjs` is what
    // reports the absence, with the install command.
    "types": ["node"],
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "playwright.config.ts"]
}
