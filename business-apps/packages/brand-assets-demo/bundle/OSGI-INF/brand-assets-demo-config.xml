<?xml version="1.0"?>
<component name="nuxeo.config.brand-assets-demo" version="1.0">
  <!-- Registers after Satori's defaults, so what it contributes applies on top of them. -->
  <require>org.nuxeo.agentic.ui.config.defaults</require>

  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <!-- Version 2 layouts sit where version 1's do (docs/business-apps/layout-v2.md, section 1).
         An asset holds a file, and has the picture schema, so its record page shows its picture
         views first, under its banners. A video asset has the video schema, so its record page
         shows its player, its facts and its storyboard first. A product and a shot hold no file. -->
    <layout type="AcmeAsset" mode="view" src="agentic-ui-config/layouts/AcmeAsset/view.layout.json" />
    <layout type="AcmeVideo" mode="view" src="agentic-ui-config/layouts/AcmeVideo/view.layout.json" />
    <layout type="AcmeProduct" mode="view" src="agentic-ui-config/layouts/AcmeProduct/view.layout.json" />
    <layout type="AcmeShot" mode="view" src="agentic-ui-config/layouts/AcmeShot/view.layout.json" />
  </extension>

  <!-- The types these layouts are for come from the stand-in model, the bundle's other
       component (brand-assets-demo-model.xml), until a brand team's own model replaces it. -->

  <!-- The app itself, for the app registry in nuxeo-agentic-core, which serves it after sign-in to
       the groups its app.json names (docs/business-apps/app-definition-v2.md, section 3). Every file
       of the app definition is named, at its place below the directory that holds app.json; the
       pipeline holds this list to the files the package has (docs/business-apps/package-pipeline.md).
       `npm run config:dev` still serves the same files to the development server, and a file it
       serves wins there (the kit's README, "Seeing it under nx serve").
       There is no bootstrap fragment on purpose: on a shared server it would rebrand everyone's app.
       The app's branding is in its app.json. -->
  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <app id="brand-assets" src="agentic-ui-config/app.json">
      <file path="navigation.json" />
      <file path="queues/library.json" />
      <file path="queues/products.json" />
      <file path="labels/en.json" />
    </app>
  </extension>
</component>
