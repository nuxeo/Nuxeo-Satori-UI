{
  "$schema": "../../../../../../libs/shared/app-definition/src/queue.schema.json",
  "version": 2,
  "labelKey": "brand.queue.library",
  "pageProvider": "acme_asset_library",
  "columns": [
    "dc:title",
    "acmeasset:product",
    "acmeasset:colorway",
    "acmeasset:shot",
    { "field": "dc:expired", "labelKey": "brand.asset.rightsEnd", "widget": "date" }
  ],
  "sort": [{ "field": "dc:expired", "order": "asc" }],
  "pageSize": 50,
  "facets": [
    { "aggregate": "acme_rights_agg", "labelKey": "brand.facet.rights" },
    { "aggregate": "acme_shot_agg", "labelKey": "brand.facet.shot" },
    { "aggregate": "acme_product_agg", "labelKey": "brand.facet.product" }
  ]
}
