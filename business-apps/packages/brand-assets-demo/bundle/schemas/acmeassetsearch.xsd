<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a brand team's own model arrives: the search document of the asset library,
     as default_search is the platform's. It is never saved. A facet's chosen buckets are sent back
     as named parameters, each named after its aggregate, such as acme_shot_agg=["Front"]; the server
     writes each into the field of the same name here, and the aggregate of that name reads its
     selection from it. So each field is named exactly as its aggregate is, in
     brand-assets-demo-model.xml. Replace it with theirs. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/brand-assets-demo/acmeassetsearch"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/brand-assets-demo/acmeassetsearch">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string" />
  </xs:simpleType>

  <!-- The rights buckets chosen in the library's Rights facet: Ended, Ending, Cleared. -->
  <xs:element name="acme_rights_agg" type="nxs:stringList" />
  <!-- The shots chosen in its Shot facet. -->
  <xs:element name="acme_shot_agg" type="nxs:stringList" />
  <!-- The products chosen in its Product facet, by style number. -->
  <xs:element name="acme_product_agg" type="nxs:stringList" />
  <!-- The types chosen in its Type facet: AcmeAsset, a picture, or AcmeVideo. -->
  <xs:element name="acme_type_agg" type="nxs:stringList" />
</xs:schema>
