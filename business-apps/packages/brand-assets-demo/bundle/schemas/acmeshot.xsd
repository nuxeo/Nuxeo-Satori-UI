<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a brand team's own model arrives: one shot a product needs, in one colourway,
     as a shot list names it. It is missing while no asset fills it: acmeshot:asset is empty, which
     is what acme_product_missing_shots asks for. Nothing sets the asset but the seed yet; a real
     model would, when an asset for the shot is approved. Replace it with theirs. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/brand-assets-demo/acmeshot"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/brand-assets-demo/acmeshot"
  xmlns:ref="http://www.nuxeo.org/ecm/schemas/core/external-references/">

  <!-- The product, by its style number: acmeproduct:style. -->
  <xs:element name="product" type="xs:string" />
  <xs:element name="colorway" type="xs:string" />
  <!-- Which shot: Front, Back, On model, Detail, Side or Campaign. -->
  <xs:element name="shot" type="xs:string" />
  <!-- The day it is needed by. -->
  <xs:element name="due" type="xs:date" />
  <!-- The asset that fills it, stored as its document's id (ecm:uuid); empty while it is missing. -->
  <xs:element name="asset">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="documentResolver" ref:store="id" />
    </xs:simpleType>
  </xs:element>
</xs:schema>
