<?xml version="1.0"?>
<component name="nuxeo.config.contracts-demo" version="1.0">
  <!-- Registers after Satori's defaults, so what it contributes applies on top of them. -->
  <require>org.nuxeo.agentic.ui.config.defaults</require>

  <!-- The app-layout generator added the view layout here, inside an org.nuxeo.agentic.ui.config
       "configuration" extension: the server serves a layout only when this component names it,
       and the package pipeline refuses one named from anywhere but its layouts/ file. The edit
       layout, which carries the field rule, was added by hand: no generator writes an edit mode.
       There is no bootstrap fragment on purpose: on a shared server it would rebrand everyone's app. -->

  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <layout type="Contract" mode="view" src="agentic-ui-config/layouts/Contract/view.layout.json" />
    <layout type="Contract" mode="edit" src="agentic-ui-config/layouts/Contract/edit.layout.json" />
  </extension>

  <!-- The types these layouts are for come from the stand-in model, the bundle's other
       component (contracts-demo-model.xml), until a real contracts model replaces it. -->

  <!-- The app itself, for the app registry in nuxeo-agentic-core, which serves it after sign-in to
       the groups its app.json names (docs/business-apps/app-definition-v2.md, section 10). Every file
       of the app definition the registry serves is named, at its place below the directory that
       holds app.json; the pipeline holds this list to the files the package has. Written by hand:
       the app-package generator does not write this element yet. -->
  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <app id="contracts" src="agentic-ui-config/app.json">
      <file path="home.json" />
      <file path="navigation.json" />
      <file path="queues/up-for-renewal.json" />
      <file path="labels/en.json" />
    </app>
  </extension>
</component>
