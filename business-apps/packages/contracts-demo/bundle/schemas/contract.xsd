<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real contracts model arrives: a fictional contract schema. Replace it with
     the real one, and the layouts and the queue follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/contracts-demo/contract"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/contracts-demo/contract">

  <!-- The contract number, such as CTR-1001. -->
  <xs:element name="number" type="xs:string" />
  <!-- The other party, by name: a fictional company. -->
  <xs:element name="counterparty" type="xs:string" />

  <xs:element name="category">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Services" />
        <xs:enumeration value="Supply" />
        <xs:enumeration value="Licence" />
        <xs:enumeration value="Lease" />
        <xs:enumeration value="NDA" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>

  <!-- A property, which the pages, the queue and the field rule read, not the lifecycle state. -->
  <xs:element name="status">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Draft" />
        <xs:enumeration value="Active" />
        <xs:enumeration value="Terminated" />
        <xs:enumeration value="Expired" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>

  <!-- The contract's total value, in contract:currency. -->
  <xs:element name="value" type="xs:double" />
  <!-- An ISO 4217 code, such as USD, which the currency widget reads. -->
  <xs:element name="currency" type="xs:string" />

  <xs:element name="start" type="xs:date" />
  <xs:element name="end" type="xs:date" />
  <!-- The days of notice either party gives before the end, to renew or end it. -->
  <xs:element name="noticeDays" type="xs:long" />
  <xs:element name="autoRenew" type="xs:boolean" />
  <!-- The contract manager's user name. -->
  <xs:element name="owner" type="xs:string" />
  <!-- Why the contract was ended early: the edit form requires it once the status is Terminated. -->
  <xs:element name="terminationReason" type="xs:string" />
  <xs:element name="notes" type="xs:string" />
</xs:schema>
