<?xml version="1.0"?>
<component name="nuxeo.config.controlled-documents-demo" version="1.0">
  <!-- Registers after Satori's defaults, so what it contributes applies on top of them. -->
  <require>org.nuxeo.agentic.ui.config.defaults</require>

  <!-- The app-layout and app-form generators add each layout here, inside an
       org.nuxeo.agentic.ui.config "configuration" extension: the server serves a layout only when
       this component names it, and the package pipeline refuses one named from anywhere but its
       layouts/ file, and a layouts/ file this component does not name.

       app.json, actions.json, queues/ and labels/ travel in this package. The app registry in
       nuxeo-agentic-core serves them, after sign-in, to the groups app.json names, as the <app>
       element below names each file (docs/business-apps/app-definition-v2.md, section 10). The
       app-registry generator writes it, and the generators that add a file keep it in step; run
       app-registry again after writing a file by hand, such as the home or the menu.
       There is no bootstrap fragment on purpose: on a shared server it would rebrand everyone's app. -->

  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <layout type="EngineeringDocument" mode="view" src="agentic-ui-config/layouts/EngineeringDocument/view.layout.json" />
    <layout type="Transmittal" mode="view" src="agentic-ui-config/layouts/Transmittal/view.layout.json" />
    <layout type="TransmittalReceipt" mode="view" src="agentic-ui-config/layouts/TransmittalReceipt/view.layout.json" />
    <layout type="ReviewCycle" mode="view" src="agentic-ui-config/layouts/ReviewCycle/view.layout.json" />
    <layout type="Transmittal" mode="create" src="agentic-ui-config/layouts/Transmittal/create.layout.json" />
    <layout type="TransmittalReceipt" mode="edit" src="agentic-ui-config/layouts/TransmittalReceipt/edit.layout.json" />
    <layout type="ReviewCycle" mode="edit" src="agentic-ui-config/layouts/ReviewCycle/edit.layout.json" />
  </extension>

  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <app id="controlled-documents" src="agentic-ui-config/app.json">
      <file path="labels/en.json" />
      <file path="queues/current.json" />
      <file path="home.json" />
      <file path="navigation.json" />
      <file path="queues/awaiting-me.json" />
      <file path="queues/transmittals.json" />
    </app>
  </extension>
</component>
