<?xml version="1.0"?>
<!--
  STAND-IN MODEL, written by the app-model generator for a demo, until a real model arrives.

  Everything here is fictional: the document types, schemas and page providers the package's
  layouts, queues and home name, and nothing more. When a real model arrives, from Studio or a
  model package, this file and schemas/ are replaced by it, and the layouts follow its property
  names. Records of these types must be deleted from a server before its model goes: a document
  whose type is gone cannot be read.

  Its own component, apart from the configuration one, so that it can be replaced whole. It
  contributes nothing to org.nuxeo.agentic.ui.config, so it needs none of Satori's defaults.
-->
<component name="nuxeo.config.controlled-documents-demo.model" version="1.0">
  <!-- Registers after the platform's own types, as a Studio project's bundle does. -->
  <require>org.nuxeo.runtime.started</require>
  <!-- By hand: the ControlledDocument facet and its controlled_document schema (docctl:) are
       nuxeo-agentic-documents', which the package depends on. -->
  <require>org.nuxeo.agentic.documents.schema</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="engdoc" prefix="engdoc" src="schemas/engdoc.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <!-- Not a folder and holds no file, so it opens as a record page. By hand: the
         ControlledDocument facet, so that the add-on numbers each document and makes a new
         revision supersede the one it names. -->
    <doctype name="EngineeringDocument" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="engdoc" />
      <facet name="ControlledDocument" />
    </doctype>
    <!-- By hand, since 0.2.0: the add-on's transmittals and review cycles, each a type with one of
         its facets and no schema of the kit's. None is a folder, so each opens as a record page.
         A transmittal is created in a TransmittalRegister, whose Create menu offers it; its
         receipts are the server's, beside it, and a review cycle is opened on a revision through
         the REST API. -->
    <doctype name="Transmittal" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <facet name="Transmittal" />
    </doctype>
    <doctype name="TransmittalReceipt" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <facet name="TransmittalReceipt" />
      <facet name="HiddenInCreation" />
    </doctype>
    <doctype name="ReviewCycle" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <facet name="ReviewCycle" />
    </doctype>
    <doctype name="TransmittalRegister" extends="Folder">
      <subtypes>
        <type>Transmittal</type>
      </subtypes>
    </doctype>
  </extension>

  <extension target="org.nuxeo.ecm.core.lifecycle.LifeCycleService" point="types">
    <types>
      <type name="EngineeringDocument">default</type>
      <type name="Transmittal">default</type>
      <type name="TransmittalReceipt">default</type>
      <type name="ReviewCycle">default</type>
      <type name="TransmittalRegister">default</type>
    </types>
  </extension>

  <!-- By hand, since 0.2.0: the words a transmittal's purpose and a receipt's answer are picked
       from, with the ids the add-on checks: it refuses any other, whatever a form offers. -->
  <extension target="org.nuxeo.ecm.directory.GenericDirectory" point="directories">
    <directory name="ControlledDocumentsPurpose" extends="template-vocabulary">
      <autoincrementIdField>false</autoincrementIdField>
      <createTablePolicy>on_missing_columns</createTablePolicy>
      <table>controlled_documents_vocabulary_purpose</table>
      <dataFile>data/vocabularies/ControlledDocumentsPurpose.csv</dataFile>
    </directory>
    <directory name="ControlledDocumentsAnswer" extends="template-vocabulary">
      <autoincrementIdField>false</autoincrementIdField>
      <createTablePolicy>on_missing_columns</createTablePolicy>
      <table>controlled_documents_vocabulary_answer</table>
      <dataFile>data/vocabularies/ControlledDocumentsAnswer.csv</dataFile>
    </directory>
    <directory name="ControlledDocumentsCycleStatus" extends="template-vocabulary">
      <autoincrementIdField>false</autoincrementIdField>
      <createTablePolicy>on_missing_columns</createTablePolicy>
      <table>controlled_documents_vocabulary_cycle_status</table>
      <dataFile>data/vocabularies/ControlledDocumentsCycleStatus.csv</dataFile>
    </directory>
  </extension>

  <extension target="org.nuxeo.ecm.platform.query.api.PageProviderService" point="providers">
    <coreQueryPageProvider name="controlled_documents_current">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'EngineeringDocument' AND (docctl:status = 'current')
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <!-- By hand: by number, the order a register is read in. -->
      <sort column="docctl:number" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_revisions">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'EngineeringDocument' AND (docctl:number = ?)
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:created" ascending="false" />
      <pageSize>20</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_superseded">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'EngineeringDocument' AND (docctl:status = 'superseded')
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:modified" ascending="false" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_awaiting_me">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'TransmittalReceipt' AND (trr:recipient = ? AND trr:status = 'awaiting')
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="trr:dueDate" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_transmittal_receipts">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'TransmittalReceipt' AND (trr:transmittal = ?)
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="trr:recipient" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_transmittals">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'Transmittal'
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="trm:issuedAt" ascending="false" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_returned">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'TransmittalReceipt' AND (trr:status = 'returned')
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="trr:respondedAt" ascending="false" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="controlled_documents_review_cycles">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'ReviewCycle' AND (rvw:document = ?)
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="rvw:openedAt" ascending="false" />
      <pageSize>20</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <!-- By hand: a review cycle's threads, Nuxeo's own comments the add-on gave the ReviewComment
         facet, each a thread's first comment, open or resolved. A reply has no status. -->
    <coreQueryPageProvider name="controlled_documents_cycle_threads">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:mixinType = 'ReviewComment' AND (rvwc:cycle = ?)
        AND rvwc:status IS NOT NULL AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:created" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
  </extension>
</component>
