<?xml version="1.0"?>
<!-- The kit's number series, for nuxeo-agentic-documents: drawings, DWG-00001 and on, revised A,
     B, C; specifications, SPEC-0001 and on, revised 1, 2, 3; and, since 0.2.0, transmittals,
     TR-00001 and on. A new engineering document names its series in docctl:series, and the server
     gives it the series' next number, never one given before. A new revision names in
     docctl:supersedes the revision it supersedes, and takes that revision's series and number. A
     new transmittal is numbered in TR, the one series for transmittals, and names none. -->
<component name="nuxeo.config.controlled-documents-demo.series">

  <require>org.nuxeo.agentic.documents</require>

  <extension target="org.nuxeo.agentic.documents" point="series">
    <series id="DWG" digits="5" revisions="letters" />
    <series id="SPEC" digits="4" revisions="numbers" />
    <series id="TR" digits="5" for="transmittals" />
  </extension>

</component>
