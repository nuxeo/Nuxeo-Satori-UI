    },
    {
      "id": "returned",
      "labelKey": "controlled-documents.home.returned",
      "kpi": { "pageProvider": "controlled_documents_returned" },
      "visibleWhen": { "type": "app.rules.inGroup", "parameters": ["document-controllers"] }
    },
    {
      "id": "superseded",
      "labelKey": "controlled-documents.home.superseded",
      "kpi": { "pageProvider": "controlled_documents_superseded" },
      "visibleWhen": { "type": "app.rules.inGroup", "parameters": ["document-controllers"] }
    }
  ]
