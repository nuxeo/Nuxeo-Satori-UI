{
  "$schema": "../../../../../../../libs/shared/app-definition/src/layout-v2.schema.json",
  "version": 2,
  "columns": 2,
  "banners": [
    {
      "id": "superseded",
      "tone": "warning",
      "labelKey": "controlled-documents.banner.superseded",
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "docctl:status" }, "superseded"]
      },
      "link": { "field": "docctl:supersededBy" }
    },
    {
      "id": "export-mark-ec1",
      "tone": "warning",
      "labelKey": "controlled-documents.banner.exportMarkEc1",
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "docmark:classification" }, "EC-1"]
      }
    },
    {
      "id": "export-mark-ec2",
      "tone": "negative",
      "labelKey": "controlled-documents.banner.exportMarkEc2",
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "docmark:classification" }, "EC-2"]
      }
    }
  ],
  "cards": [
    {
      "id": "control",
      "labelKey": "controlled-documents.card.control",
      "fields": [
        { "field": "docctl:number", "labelKey": "controlled-documents.field.number" },
        { "field": "docctl:revision", "labelKey": "controlled-documents.field.revision" },
        {
          "field": "docctl:status",
          "labelKey": "controlled-documents.field.status",
          "widget": "status-badge",
          "parameters": { "tones": { "current": "positive", "superseded": "warning" } }
        },
        { "field": "docctl:series", "labelKey": "controlled-documents.field.series" },
        {
          "field": "docctl:supersedes",
          "labelKey": "controlled-documents.field.supersedes",
          "widget": "document-link"
        },
        {
          "field": "docctl:supersededBy",
          "labelKey": "controlled-documents.field.supersededBy",
          "widget": "document-link"
        },
        {
          "field": "docmark:classification",
          "labelKey": "controlled-documents.field.exportMark",
          "widget": "status-badge",
          "parameters": { "tones": { "EC-1": "warning", "EC-2": "negative" } }
        },
        {
          "field": "docmark:groups",
          "labelKey": "controlled-documents.field.exportGroups",
          "widget": "group"
        },
        {
          "field": "docmark:markedBy",
          "labelKey": "controlled-documents.field.markedBy",
          "widget": "user"
        },
        {
          "field": "docmark:markedAt",
          "labelKey": "controlled-documents.field.markedAt",
          "widget": "date"
        },
        {
          "field": "docrev:cycles",
          "labelKey": "controlled-documents.field.reviewsClosed",
          "widget": "table",
          "parameters": {
            "columns": [
              {
                "field": "docrev:closedAt",
                "labelKey": "controlled-documents.field.closedAt",
                "widget": "date"
              },
              {
                "field": "docrev:closedBy",
                "labelKey": "controlled-documents.field.closedBy",
                "widget": "user"
              },
              {
                "field": "docrev:comments",
                "labelKey": "controlled-documents.field.threadsResolved",
                "widget": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "document",
      "labelKey": "controlled-documents.card.document",
      "fields": [
        { "field": "dc:title", "labelKey": "controlled-documents.field.title" },
        { "field": "engdoc:category", "labelKey": "controlled-documents.field.category" },
        { "field": "engdoc:discipline", "labelKey": "controlled-documents.field.discipline" },
        { "field": "engdoc:project", "labelKey": "controlled-documents.field.project" },
        { "field": "engdoc:purpose", "labelKey": "controlled-documents.field.purpose" },
        {
          "field": "engdoc:originator",
          "labelKey": "controlled-documents.field.originator",
          "widget": "user"
        },
        {
          "field": "engdoc:issuedOn",
          "labelKey": "controlled-documents.field.issuedOn",
          "widget": "date"
        },
        {
          "field": "dc:description",
          "labelKey": "controlled-documents.field.description",
          "widget": "long-text"
        }
      ]
    },
    {
      "id": "revisions",
      "labelKey": "controlled-documents.card.revisions",
      "span": 2,
      "related": {
        "pageProvider": "controlled_documents_revisions",
        "parameters": [{ "field": "docctl:number" }],
        "columns": [
          { "field": "docctl:revision", "labelKey": "controlled-documents.field.revision" },
          { "field": "dc:title", "labelKey": "controlled-documents.field.title" },
          {
            "field": "docctl:status",
            "labelKey": "controlled-documents.field.status",
            "widget": "status-badge",
            "parameters": { "tones": { "current": "positive", "superseded": "warning" } }
          },
          {
            "field": "engdoc:issuedOn",
            "labelKey": "controlled-documents.field.issuedOn",
            "widget": "date"
          }
        ],
        "sort": [{ "field": "dc:created", "order": "desc" }],
        "pageSize": 20
      }
    },
    {
      "id": "reviews",
      "labelKey": "controlled-documents.card.reviews",
      "span": 2,
      "related": {
        "pageProvider": "controlled_documents_review_cycles",
        "parameters": [{ "field": "ecm:uuid" }],
        "columns": [
          { "field": "dc:title", "labelKey": "controlled-documents.field.title" },
          {
            "field": "rvw:status",
            "labelKey": "controlled-documents.field.cycleStatus",
            "widget": "status-badge",
            "parameters": { "tones": { "open": "info", "closed": "positive" } }
          },
          {
            "field": "rvw:openedBy",
            "labelKey": "controlled-documents.field.openedBy",
            "widget": "user"
          },
          {
            "field": "rvw:openedAt",
            "labelKey": "controlled-documents.field.openedAt",
            "widget": "date"
          },
          {
            "field": "rvw:closedAt",
            "labelKey": "controlled-documents.field.closedAt",
            "widget": "date"
          },
          {
            "field": "rvw:comments",
            "labelKey": "controlled-documents.field.threadsResolved",
            "widget": "number"
          }
        ],
        "sort": [{ "field": "rvw:openedAt", "order": "desc" }],
        "pageSize": 20
      }
    },
    {
      "id": "history",
      "labelKey": "controlled-documents.card.history",
      "span": 2,
      "timeline": { "pageSize": 10 }
    }
  ]
}
