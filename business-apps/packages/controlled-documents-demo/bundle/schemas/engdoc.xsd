<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional engdoc schema of the EngineeringDocument type,
     written by the app-model generator. Replace it with the real one, and the layouts and the
     queues follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/controlled-documents-demo/engdoc"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/controlled-documents-demo/engdoc">

  <xs:element name="discipline">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Civil" />
        <xs:enumeration value="Mechanical" />
        <xs:enumeration value="Electrical" />
        <xs:enumeration value="Process" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="category">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Drawing" />
        <xs:enumeration value="Specification" />
        <xs:enumeration value="Procedure" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="project" type="xs:string" />
  <xs:element name="originator" type="xs:string" />
  <xs:element name="purpose">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="For information" />
        <xs:enumeration value="For review" />
        <xs:enumeration value="For construction" />
        <xs:enumeration value="As built" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="issuedOn" type="xs:date" />
</xs:schema>
