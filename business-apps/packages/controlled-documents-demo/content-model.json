{
  "doctypes": {
    "EngineeringDocument": {
      "parent": "Document",
      "facets": ["ControlledDocument"],
      "schemas": [
        "common",
        "dublincore",
        "engdoc",
        "controlled_document",
        "controlled_review",
        "export_mark"
      ]
    },
    "Transmittal": {
      "parent": "Document",
      "facets": ["Transmittal"],
      "schemas": ["common", "dublincore", "transmittal"]
    },
    "TransmittalReceipt": {
      "parent": "Document",
      "facets": ["TransmittalReceipt"],
      "schemas": ["common", "dublincore", "transmittal_receipt"]
    },
    "ReviewCycle": {
      "parent": "Document",
      "facets": ["ReviewCycle"],
      "schemas": ["common", "dublincore", "review_cycle"]
    },
    "TransmittalRegister": {
      "parent": "Folder",
      "facets": [],
      "schemas": ["common", "dublincore"]
    }
  },
  "facets": [
    {
      "name": "ControlledDocument",
      "schemas": [
        {
          "name": "controlled_document",
          "prefix": "docctl",
          "@prefix": "docctl",
          "fields": {
            "series": "string",
            "number": "string",
            "revision": "string",
            "status": "string",
            "supersedes": "string",
            "supersededBy": "string"
          }
        },
        {
          "name": "controlled_review",
          "prefix": "docrev",
          "@prefix": "docrev",
          "fields": {
            "cycles": {
              "type": "complex[]",
              "fields": {
                "cycle": "string",
                "closedBy": "string",
                "closedAt": "date",
                "comments": "long"
              }
            }
          }
        },
        {
          "name": "export_mark",
          "prefix": "docmark",
          "@prefix": "docmark",
          "fields": {
            "classification": "string",
            "groups": "string[]",
            "markedBy": "string",
            "markedAt": "date"
          }
        }
      ]
    },
    {
      "name": "Transmittal",
      "schemas": [
        {
          "name": "transmittal",
          "prefix": "trm",
          "@prefix": "trm",
          "fields": {
            "number": "string",
            "documents": "string[]",
            "items": {
              "type": "complex[]",
              "fields": {
                "document": "string",
                "number": "string",
                "revision": "string",
                "title": "string"
              }
