            "recipients": "string[]",
            "purpose": "string",
            "dueDate": "date",
            "issuedBy": "string",
            "issuedAt": "date"
          }
        }
      ]
    },
    {
      "name": "TransmittalReceipt",
      "schemas": [
        {
          "name": "transmittal_receipt",
          "prefix": "trr",
          "@prefix": "trr",
          "fields": {
            "transmittal": "string",
            "number": "string",
            "recipient": "string",
            "purpose": "string",
            "dueDate": "date",
            "issuedBy": "string",
            "status": "string",
            "comment": "string",
            "respondedAt": "date"
          }
        }
      ]
    },
    {
