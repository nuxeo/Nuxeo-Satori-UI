<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional film schema of the Film type,
     written by the app-model generator, and its release windows added by hand, which the
     generator cannot write: a complex list. Replace it with the real one, and the layouts, the
     queues and the rights policy follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/media-demo/film"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/media-demo/film">

  <xs:element name="year" type="xs:long" />
  <xs:element name="director" type="xs:string" />
  <xs:element name="genre">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Drama" />
        <xs:enumeration value="Comedy" />
        <xs:enumeration value="Documentary" />
        <xs:enumeration value="Thriller" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="originalLanguage" type="xs:string" />

  <!-- By hand: the film's release windows, each a territory and a channel open from one day to
       another, both included, in UTC. The rights policy (media-demo-rights.xml) reads them for
       each of the film's localised versions; the subfields' names are nuxeo-agentic-assets'. -->
  <xs:element name="windows" type="nxs:releaseWindows" />
  <xs:complexType name="releaseWindows">
    <xs:sequence>
      <xs:element name="window" type="nxs:releaseWindow" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="releaseWindow">
    <xs:sequence>
      <xs:element name="territory" type="xs:string" />
      <xs:element name="channel" type="xs:string" />
      <xs:element name="from" type="xs:date" />
      <xs:element name="until" type="xs:date" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>
