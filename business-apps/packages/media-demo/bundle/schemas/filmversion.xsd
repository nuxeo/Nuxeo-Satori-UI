<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional filmversion schema of the FilmVersion type,
     written by the app-model generator. Replace it with the real one, and the layouts and the
     queues follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/media-demo/filmversion"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/media-demo/filmversion">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string" />
  </xs:simpleType>

  <xs:element name="film" type="xs:string" />
  <xs:element name="language">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="English" />
        <xs:enumeration value="French" />
        <xs:enumeration value="German" />
        <xs:enumeration value="Spanish" />
        <xs:enumeration value="Italian" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="territories" type="nxs:stringList" />
  <xs:element name="channels" type="nxs:stringList" />
</xs:schema>
