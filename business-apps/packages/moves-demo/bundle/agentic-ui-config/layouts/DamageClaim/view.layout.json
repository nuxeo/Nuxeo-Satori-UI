{
  "$schema": "../../../../../../../libs/shared/app-definition/src/layout-v2.schema.json",
  "version": 2,
  "columns": 2,
  "banners": [
    {
      "id": "denied",
      "tone": "negative",
      "labelKey": "moves.banner.claim.denied",
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "dmg:state" }, "Denied"]
      }
    }
  ],
  "cards": [
    {
      "id": "claim",
      "labelKey": "moves.card.damageClaim.claim",
      "fields": [
        "dmg:number",
        { "field": "dc:title", "labelKey": "moves.field.claimTitle" },
        {
          "field": "dmg:move",
          "widget": "document-link",
          "parameters": { "types": ["Move"] }
        },
        {
          "field": "dmg:state",
          "widget": "status-badge",
          "parameters": {
            "tones": {
              "Filed": "info",
              "In review": "warning",
              "Approved": "positive",
              "Denied": "negative",
              "Paid": "positive"
            }
          }
        },
        { "field": "dmg:adjuster", "widget": "user" }
      ]
    },
    {
      "id": "dates",
      "labelKey": "moves.card.damageClaim.dates",
      "fields": [
        { "field": "dmg:deliveredOn", "widget": "date", "parameters": { "format": "long" } },
        { "field": "dmg:filedOn", "widget": "date", "parameters": { "format": "long" } },
        {
          "id": "daysToFile",
          "labelKey": "moves.field.daysToFile",
          "widget": "number",
          "computed": {
            "type": "core.dateDiff",
            "parameters": [{ "field": "dmg:deliveredOn" }, { "field": "dmg:filedOn" }, "days"]
          }
        },
        { "field": "dmg:decidedOn", "widget": "date", "parameters": { "format": "long" } }
      ]
    },
    {
      "id": "items",
      "labelKey": "moves.card.damageClaim.items",
      "fields": [
        {
          "field": "dmg:items",
          "widget": "document-link",
          "parameters": { "types": ["MoveItem"] }
        },
        {
          "field": "dmg:amountClaimed",
          "widget": "currency",
          "parameters": { "currency": "USD" }
        },
        {
          "field": "dmg:amountApproved",
          "widget": "currency",
          "parameters": { "currency": "USD" }
        },
        { "field": "dmg:details", "widget": "long-text" }
      ]
    },
    {
      "id": "attachments",
      "labelKey": "moves.card.damageClaim.attachments",
      "fields": [{ "field": "files:files", "widget": "file-list" }]
    },
    {
      "id": "denial",
      "labelKey": "moves.card.damageClaim.denial",
      "span": 2,
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "dmg:state" }, "Denied"]
      },
      "fields": [{ "field": "dmg:denialReason", "widget": "long-text" }]
    },
    {
      "id": "history",
      "labelKey": "moves.card.damageClaim.history",
      "span": 2,
      "timeline": { "pageSize": 10 }
    }
  ]
}
