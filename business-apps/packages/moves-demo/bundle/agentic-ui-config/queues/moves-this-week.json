{
  "$schema": "../../../../../../libs/shared/app-definition/src/queue.schema.json",
  "version": 2,
  "labelKey": "moves.queue.moves-this-week",
  "pageProvider": "moves_this_week",
  "columns": [
    "move:number",
    { "field": "dc:title", "labelKey": "moves.field.moveTitle" },
    {
      "field": "move:state",
      "widget": "status-badge",
      "parameters": {
        "tones": {
          "Booked": "info",
          "Packed": "info",
          "In transit": "warning",
          "Delivered": "positive",
          "Cancelled": "neutral"
        }
      }
    },
    { "field": "move:loadDate", "widget": "date" },
    { "field": "move:deliveryDate", "widget": "date" },
    { "field": "move:crewLead", "widget": "user" },
    "move:truck"
  ],
  "sort": [
    {
      "field": "move:loadDate",
      "order": "asc"
    }
  ],
  "pageSize": 50
}
