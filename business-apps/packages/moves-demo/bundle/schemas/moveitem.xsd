<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional moveitem schema of the MoveItem type,
     written by the app-model generator. Replace it with the real one, and the layouts and the
     queues follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/moves-demo/moveitem"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/moves-demo/moveitem">

  <xs:element name="move" type="xs:string" />
  <xs:element name="tag" type="xs:string" />
  <xs:element name="room">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Kitchen" />
        <xs:enumeration value="Living room" />
        <xs:enumeration value="Dining room" />
        <xs:enumeration value="Bedroom" />
        <xs:enumeration value="Office" />
        <xs:enumeration value="Garage" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="condition">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Good" />
        <xs:enumeration value="Worn" />
        <xs:enumeration value="Scratched" />
        <xs:enumeration value="Damaged" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="declaredValue" type="xs:double" />
</xs:schema>
