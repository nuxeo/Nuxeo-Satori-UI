<?xml version="1.0"?>
<!--
  STAND-IN MODEL, written by the app-model generator for a demo, until a real model arrives.

  Everything here is fictional: the document types, schemas and page providers the package's
  layouts, queues and home name, and nothing more. When a real model arrives, from Studio or a
  model package, this file and schemas/ are replaced by it, and the layouts follow its property
  names. Records of these types must be deleted from a server before its model goes: a document
  whose type is gone cannot be read.

  Its own component, apart from the configuration one, so that it can be replaced whole. It
  contributes nothing to org.nuxeo.agentic.ui.config, so it needs none of Satori's defaults.
-->
<component name="nuxeo.config.onboarding-demo.model" version="1.0">
  <!-- Registers after the platform's own types, as a Studio project's bundle does. -->
  <require>org.nuxeo.runtime.started</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="onboarding" prefix="onb" src="schemas/onboarding.xsd" />
    <schema name="dispute" prefix="dsp" src="schemas/dispute.xsd" />
    <schema name="onboarding_search" prefix="onbsearch" src="schemas/onboardingsearch.xsd" />
    <schema name="dispute_search" prefix="dspsearch" src="schemas/disputesearch.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <!-- Not a folder, and holds no file of its own: its attachments are files:files. So it
         opens as a record page. -->
    <doctype name="OnboardingCase" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="files" />
      <schema name="onboarding" />
    </doctype>
    <!-- Not a folder, and holds no file of its own: its attachments are files:files. So it
         opens as a record page. -->
    <doctype name="DisputeCase" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="files" />
      <schema name="dispute" />
    </doctype>
    <!-- The search document of OnboardingCase's page providers of the search index, as DefaultSearch
         is default_search's. Never saved: it holds the buckets a queue's facets send back. No
         folder lists it among its subtypes, and it is hidden from navigation. -->
    <doctype name="OnboardingCaseSearch" extends="Document">
      <facet name="HiddenInNavigation" />
      <schema name="onboarding_search" />
    </doctype>
    <!-- The search document of DisputeCase's page providers of the search index, as DefaultSearch
         is default_search's. Never saved: it holds the buckets a queue's facets send back. No
         folder lists it among its subtypes, and it is hidden from navigation. -->
    <doctype name="DisputeCaseSearch" extends="Document">
      <facet name="HiddenInNavigation" />
      <schema name="dispute_search" />
    </doctype>
  </extension>

  <extension target="org.nuxeo.ecm.core.lifecycle.LifeCycleService" point="types">
    <types>
      <type name="OnboardingCase">default</type>
    </types>
    <types>
      <type name="DisputeCase">default</type>
    </types>
  </extension>

  <extension target="org.nuxeo.ecm.platform.query.api.PageProviderService" point="providers">
    <genericPageProvider name="onboarding_open_cases"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>OnboardingCaseSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'OnboardingCase' AND (onb:status IN ('Open', 'KYC review', 'Awaiting signature'))
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="onb_status_agg" type="terms" parameter="onb:status">
          <field schema="onboarding_search" name="onb_status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
        <aggregate id="onb_riskRating_agg" type="terms" parameter="onb:riskRating">
          <field schema="onboarding_search" name="onb_riskRating_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="onb:openedOn" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>
    <genericPageProvider name="onboarding_open_disputes"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>DisputeCaseSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'DisputeCase' AND (dsp:status IN ('Open', 'Investigating'))
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="dsp_reason_agg" type="terms" parameter="dsp:reason">
          <field schema="dispute_search" name="dsp_reason_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
        <aggregate id="dsp_status_agg" type="terms" parameter="dsp:status">
          <field schema="dispute_search" name="dsp_status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="dsp:dueOn" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>
    <coreQueryPageProvider name="onboarding_case_signatures">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'ESignatureRequest' AND (sigreq:document = ?)
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="sigreq:requestedAt" ascending="false" />
      <pageSize>20</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <!-- A case's disputes, newest first, by the case's id: the case page's related list.
         Written by hand, as the case's signature requests' are. -->
    <coreQueryPageProvider name="onboarding_case_disputes">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'DisputeCase' AND (dsp:case = ?)
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dsp:openedOn" ascending="false" />
      <pageSize>20</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
    <!-- The disputes registers, the oldest first: the first is where a dispute raised from a
         case's page is filed (layout-v2.md, section 7, a related list's "in"). The reader's own
         permissions decide which they see, and whether they may add to it. -->
    <coreQueryPageProvider name="onboarding_dispute_registers">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'DisputeRegister'
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:created" ascending="true" />
      <pageSize>1</pageSize>
      <maxPageSize>10</maxPageSize>
    </coreQueryPageProvider>
    <coreQueryPageProvider name="onboarding_awaiting_signature">
      <pattern>
        SELECT * FROM Document WHERE ecm:primaryType = 'ESignatureRequest' AND (sigreq:status = 'sent')
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="sigreq:requestedAt" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>
  </extension>
</component>
