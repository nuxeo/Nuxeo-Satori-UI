    {
      "id": "high-risk",
      "labelKey": "onboarding.home.highRisk",
      "kpi": {
        "pageProvider": "onboarding_open_cases",
        "aggregate": "onb_riskRating_agg",
        "bucket": "High"
      },
      "queue": "open-cases",
      "visibleWhen": {
        "type": "app.rules.inGroup",
        "parameters": ["onboarding-officers", "kyc-analysts"]
      }
    },
    {
      "id": "awaiting-signature",
      "labelKey": "onboarding.home.awaitingSignature",
      "kpi": { "pageProvider": "onboarding_awaiting_signature" },
