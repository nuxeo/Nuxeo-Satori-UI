{
  "$schema": "../../../../../../libs/shared/app-definition/src/queue.schema.json",
  "version": 2,
  "labelKey": "onboarding.queue.open-disputes",
  "pageProvider": "onboarding_open_disputes",
  "columns": [
    "dsp:number",
    { "field": "dc:title", "labelKey": "onboarding.field.disputeTitle" },
    "dsp:customer",
    { "field": "dsp:amount", "widget": "currency", "parameters": { "currency": "USD" } },
    {
      "field": "dsp:reason",
      "widget": "status-badge",
      "parameters": {
        "tones": {
          "Unauthorised": "negative",
          "Not received": "warning",
          "Duplicate": "info",
          "Defective": "warning",
          "Other": "neutral"
        }
      }
    },
    {
      "field": "dsp:status",
      "widget": "status-badge",
      "parameters": { "tones": { "Open": "info", "Investigating": "warning" } }
    },
    { "field": "dsp:dueOn", "widget": "relative-date" },
    { "field": "dsp:analyst", "widget": "user" }
  ],
  "sort": [{ "field": "dsp:dueOn", "order": "asc" }],
  "pageSize": 50,
  "facets": [
    { "aggregate": "dsp_reason_agg", "labelKey": "onboarding.facet.reason" },
    { "aggregate": "dsp_status_agg", "labelKey": "onboarding.facet.disputeStatus" }
  ]
}
