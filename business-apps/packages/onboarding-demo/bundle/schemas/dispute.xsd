<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional dispute schema of the DisputeCase type,
     written by the app-model generator. Replace it with the real one, and the layouts and the
     queues follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/onboarding-demo/dispute"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/onboarding-demo/dispute"
  xmlns:ref="http://www.nuxeo.org/ecm/schemas/core/external-references/">

  <xs:element name="number" type="xs:string" />
  <xs:element name="customer" type="xs:string" />
  <xs:element name="account" type="xs:string" />
  <xs:element name="amount" type="xs:double" />
  <xs:element name="reason">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Unauthorised" />
        <xs:enumeration value="Not received" />
        <xs:enumeration value="Duplicate" />
        <xs:enumeration value="Defective" />
        <xs:enumeration value="Other" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="status">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Open" />
        <xs:enumeration value="Investigating" />
        <xs:enumeration value="Resolved for customer" />
        <xs:enumeration value="Resolved for bank" />
        <xs:enumeration value="Closed" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="openedOn" type="xs:date" />
  <xs:element name="dueOn" type="xs:date" />
  <xs:element name="analyst" type="xs:string" />
  <xs:element name="resolution" type="xs:string" />
  <!-- The onboarding case the dispute is raised on, if any, stored as its document's id, which
       onboarding_case_disputes is given. Written by hand: app-model writes no reference. -->
  <xs:element name="case">
    <xs:simpleType>
      <xs:restriction base="xs:string" ref:resolver="documentResolver" ref:store="id" />
    </xs:simpleType>
  </xs:element>
</xs:schema>
