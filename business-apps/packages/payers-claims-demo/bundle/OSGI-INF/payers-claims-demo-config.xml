<?xml version="1.0"?>
<component name="nuxeo.config.payers-claims-demo" version="1.0">
  <!-- Registers after Satori's defaults, so what it contributes applies on top of them. -->
  <require>org.nuxeo.agentic.ui.config.defaults</require>

  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <!-- A version 2 layout sits where version 1's do (docs/business-apps/layout-v2.md, section 1).
         The view mode is new in version 2, so an app that reads only version 1 never asks for it. -->
    <layout type="Claim" mode="view" src="agentic-ui-config/layouts/Claim/view.layout.json" />
    <layout type="Member" mode="view" src="agentic-ui-config/layouts/Member/view.layout.json" />
    <layout type="Case" mode="view" src="agentic-ui-config/layouts/Case/view.layout.json" />
    <layout type="Provider" mode="view" src="agentic-ui-config/layouts/Provider/view.layout.json" />
    <!-- Version 1, for the Properties panel beside the Member page: every member property but the
         social security number. Without it the panel lists the member schema whole, and shows the
         number to everyone the Member page hides it from. Version 1 has no rules, so it is left
         out of the panel for everyone; member services read it on the page. -->
    <layout type="Member" mode="metadata" src="agentic-ui-config/layouts/Member/metadata.layout.json" />
  </extension>

  <!-- The types these layouts are for come from the stand-in model, the bundle's other
       component (payers-claims-demo-model.xml), until the presales Payers model replaces it. -->

  <!-- The app itself, for the app registry in nuxeo-agentic-core, which serves it after sign-in to
       the groups its app.json names (docs/business-apps/app-definition-v2.md, section 3). Every file
       of the app definition is named, at its place below the directory that holds app.json; the
       pipeline holds this list to the files the package has (docs/business-apps/package-pipeline.md).
       `npm run config:dev` still serves the same files to the development server, and a file it
       serves wins there (the kit's README, "Seeing it under nx serve").
       There is no bootstrap fragment on purpose: on a shared server it would rebrand everyone's app.
       The app's branding is in its app.json. -->
  <extension target="org.nuxeo.agentic.ui.config" point="configuration">
    <app id="payers-claims" src="agentic-ui-config/app.json">
      <file path="home.json" />
      <file path="navigation.json" />
      <file path="queues/unassigned-claims.json" />
      <file path="queues/my-claims.json" />
      <file path="queues/pending-determination.json" />
      <file path="queues/open-appeals.json" />
      <file path="labels/en.json" />
      <file path="actions.json" />
      <!-- The claims review workflow's task forms, one per step with a task
           (payers-claims-demo-workflow.xml): tasks/<workflow>.<step>.layout.json. -->
      <file path="tasks/PayersClaimReview.determine.layout.json" />
      <file path="tasks/PayersClaimReview.supervisorApproval.layout.json" />
    </app>
  </extension>
</component>
