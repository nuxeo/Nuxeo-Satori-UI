<?xml version="1.0"?>
<!--
  STAND-IN MODEL, until the presales Payers model arrives.

  Everything here is fictional: the document types, schemas and page providers the kit's layouts,
  queues and home name, and the claim lifecycle the claims review workflow follows, with what keeps
  claim:status in step with it. When the presales model arrives, this file and schemas/ are
  replaced by theirs, and the layouts follow its property names. Records of these types must be
  deleted from a server before its model goes: a document whose type is gone cannot be read.

  Its own component, apart from the configuration one, so that it can be replaced whole. It
  contributes nothing to org.nuxeo.agentic.ui.config, so it needs none of Satori's defaults.
-->
<component name="nuxeo.config.payers-claims-demo.model" version="1.0">
  <!-- Registers after the platform's own types, as a Studio project's bundle does. -->
  <require>org.nuxeo.runtime.started</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="member" prefix="member" src="schemas/member.xsd" />
    <schema name="claim" prefix="claim" src="schemas/claim.xsd" />
    <schema name="case" prefix="case" src="schemas/case.xsd" />
    <schema name="provider" prefix="provider" src="schemas/provider.xsd" />
    <schema name="claimdoc" prefix="claimdoc" src="schemas/claimdoc.xsd" />
    <schema name="payers_claim_search" prefix="claimsearch" src="schemas/claimsearch.xsd" />
  </extension>

  <!-- None of the four record types holds a file or is a folder, so each opens as a record
       page. -->
  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="Member" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="member" />
    </doctype>
    <doctype name="Claim" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="claim" />
    </doctype>
    <doctype name="Case" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="case" />
    </doctype>
    <doctype name="Provider" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="provider" />
    </doctype>
    <!-- A file: it keeps its preview, and is listed on its claim's page. -->
    <doctype name="ClaimDocument" extends="File">
      <schema name="claimdoc" />
    </doctype>
    <!-- The kit's queues' search document, as DefaultSearch is default_search's: never saved, it
         holds the facets a queue sends back (schemas/claimsearch.xsd), the open-appeals queue's
         since 0.6.0 as well as the claim queues'. No folder lists it among
         its subtypes, so nothing offers to create one, and it is hidden from navigation. -->
    <doctype name="PayersClaimSearch" extends="Document">
      <facet name="HiddenInNavigation" />
      <schema name="payers_claim_search" />
    </doctype>
  </extension>

  <!-- A claim's lifecycle: its states are claim:status's values, so the two are one. The claims
       review workflow (payers-claims-demo-workflow.xml) moves a claim through it: review when it
       starts, then approve or deny. pend and resume put a claim on hold and back, pay settles an
       approved one, and reopen brings a decided one back to review, as an adjustment or an appeal
       does.

       project is the platform's default lifecycle's first state, which a claim created before
       version 0.4.0 is in: the lifecycle is read from the type, not kept on the document, so such
       a claim follows this lifecycle from the upgrade. Its one way out, submit, is the seed's to
       follow (demo/seed.mjs), on the way to the claim's status. No transition leads back to it,
       and no claim starts in it. -->
  <extension target="org.nuxeo.ecm.core.lifecycle.LifeCycleService" point="lifecycle">
    <lifecycle name="payersClaim" defaultInitial="submitted">
      <transitions>
        <transition name="review" destinationState="inReview">
          <description>Start reviewing the claim</description>
        </transition>
        <transition name="pend" destinationState="pended">
          <description>Hold the claim, waiting on information</description>
        </transition>
        <transition name="resume" destinationState="inReview">
          <description>Review the held claim again</description>
        </transition>
        <transition name="approve" destinationState="approved">
          <description>Approve the claim</description>
        </transition>
        <transition name="deny" destinationState="denied">
          <description>Deny the claim</description>
        </transition>
        <transition name="pay" destinationState="paid">
          <description>Pay the approved claim</description>
        </transition>
        <transition name="reopen" destinationState="inReview">
          <description>Review a decided claim again, as an adjustment or an appeal</description>
        </transition>
        <transition name="submit" destinationState="submitted">
          <description>Bring a claim created before version 0.4.0 into this lifecycle</description>
        </transition>
      </transitions>
      <states>
        <state name="submitted" description="Received, not yet reviewed" initial="true">
          <transitions>
            <transition>review</transition>
          </transitions>
        </state>
        <state name="inReview" description="Being determined">
          <transitions>
            <transition>pend</transition>
            <transition>approve</transition>
            <transition>deny</transition>
          </transitions>
        </state>
        <state name="pended" description="Held, waiting on information">
          <transitions>
            <transition>resume</transition>
            <transition>approve</transition>
            <transition>deny</transition>
          </transitions>
        </state>
        <state name="approved" description="Approved, not yet paid">
          <transitions>
            <transition>pay</transition>
            <transition>reopen</transition>
          </transitions>
        </state>
        <state name="denied" description="Denied">
          <transitions>
            <transition>reopen</transition>
          </transitions>
        </state>
        <state name="paid" description="Paid">
          <transitions>
            <transition>reopen</transition>
          </transitions>
        </state>
        <state name="project" description="A claim created before version 0.4.0">
          <transitions>
            <transition>submit</transition>
          </transitions>
        </state>
      </states>
    </lifecycle>
  </extension>

  <!-- The platform's default lifecycle for every other type, so that a record has a lifecycle
       state. A claim has its own, above. -->
  <extension target="org.nuxeo.ecm.core.lifecycle.LifeCycleService" point="types">
    <types>
      <type name="Member">default</type>
      <type name="Claim">payersClaim</type>
      <type name="Case">default</type>
      <type name="Provider">default</type>
      <type name="ClaimDocument">default</type>
    </types>
  </extension>

  <!-- claim:status is the lifecycle state, after every transition, whoever follows it: the
       workflow, a lifecycle button, or the seed. Written by the handler of the platform's
       lifecycle_transition_event, which Nuxeo fires with the claim as read after the transition. -->
  <extension target="org.nuxeo.ecm.core.operation.OperationServiceComponent" point="chains">
    <chain id="PayersClaim.KeepStatus">
      <operation id="Context.FetchDocument" />
      <operation id="Document.SetProperty">
        <param type="string" name="xpath">claim:status</param>
        <param type="serializable" name="value">expr:Document.lifeCycle</param>
        <param type="boolean" name="save">true</param>
      </operation>
    </chain>
  </extension>
  <extension target="org.nuxeo.ecm.core.operation.OperationServiceComponent" point="event-handlers">
    <handler chainId="PayersClaim.KeepStatus">
      <event>lifecycle_transition_event</event>
      <filters>
        <doctype>Claim</doctype>
      </filters>
    </handler>
  </extension>

  <!-- Every page provider binds what it is given as a quoted, escaped literal, and leaves out
       versions, proxies and trashed records. -->
  <extension target="org.nuxeo.ecm.platform.query.api.PageProviderService" point="providers">
    <!-- The Member page's claims card: the member's claims, given the member's ecm:uuid. -->
    <coreQueryPageProvider name="member_claims">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'Claim' AND claim:member = ?
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="claim:serviceDate" ascending="false" />
      <pageSize>10</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>

    <!-- The Member page's cases card: the member's cases, given the member's ecm:uuid. -->
    <coreQueryPageProvider name="member_cases">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'Case' AND case:member = ?
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:modified" ascending="false" />
      <pageSize>10</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>

    <!-- The Provider page's claims card: the claims billed by the provider, given its ecm:uuid. -->
    <coreQueryPageProvider name="provider_claims">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'Claim' AND claim:provider = ?
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="claim:serviceDate" ascending="false" />
      <pageSize>10</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>

    <!-- The Claim page's documents card: the claim's documents, given its claim:number. -->
    <coreQueryPageProvider name="payers_claim_documents">
      <pattern quoteParameters="true" escapeParameters="true">
        SELECT * FROM Document WHERE ecm:primaryType = 'ClaimDocument' AND claimdoc:claim = ?
        AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
      </pattern>
      <sort column="dc:modified" ascending="false" />
      <pageSize>10</pageSize>
      <maxPageSize>100</maxPageSize>
    </coreQueryPageProvider>

    <!-- The claim queues and the home's KPIs. A queue's facets and a KPI's buckets are the
         aggregates of its page provider's results, which only the search index answers: a
         coreQueryPageProvider queries the repository and returns none. So these three are
         SearchServicePageProvider, the class the platform's default_search is replaced with
         (nxserver/config/search-classreplacer-config.xml), each with the search document
         PayersClaimSearch, whose fields hold a queue's chosen buckets. An aggregate's id, its
         field and the parameter the app sends back are one name.

         The index is written a moment after the repository, so these lag a change by about a
         second; the seed asks them again until they agree with what it wrote. -->

    <!-- The unassigned-claims queue: claims no adjuster holds yet, still to be decided. -->
    <genericPageProvider name="payers_unassigned_claims"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>PayersClaimSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'Claim' AND claim:adjuster IS NULL
          AND claim:status IN ('submitted', 'inReview')
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="claim_status_agg" type="terms" parameter="claim:status">
          <field schema="payers_claim_search" name="claim_status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="claim:received" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>

    <!-- The my-claims queue: the claims one adjuster holds, given their user name. The queue and
         the home pass "$currentUser", which the REST API's page provider endpoint replaces with
         the person signed in before the query runs (QueryExecutor in nuxeo-search-rest-api;
         measured on Nuxeo 2025.10.18, as two adjusters), so each is asked for their own claims
         and no one's name is in a file. Whether version 2 says so is open
         (app-definition-v2.md, section 13). -->
    <genericPageProvider name="payers_my_claims"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>PayersClaimSearch</searchDocumentType>
      <whereClause>
        <fixedPart quoteParameters="true" escapeParameters="true">
          ecm:primaryType = 'Claim' AND claim:adjuster = ?
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="claim_status_agg" type="terms" parameter="claim:status">
          <field schema="payers_claim_search" name="claim_status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="claim:serviceDate" ascending="false" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>

    <!-- The pending-determination queue, and the list behind the home's "Pending determination"
         KPI: claims in review or pended, whoever holds them, oldest first. -->
    <genericPageProvider name="payers_pending_claims"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>PayersClaimSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'Claim' AND claim:status IN ('inReview', 'pended')
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="claim_status_agg" type="terms" parameter="claim:status">
          <field schema="payers_claim_search" name="claim_status_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
        <aggregate id="claim_adjuster_agg" type="terms" parameter="claim:adjuster">
          <field schema="payers_claim_search" name="claim_adjuster_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="claim:received" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>

    <!-- Since 0.6.0, the open-appeals queue, and the list behind the home's "Open appeals" KPI:
         appeals not yet decided, open or in review, whoever holds them, the nearest due first.
         Its facets are a case's state and its assignee, read from the same search document as
         the claim queues', whose schema holds a field for each (schemas/claimsearch.xsd). A
         grievance, and an appeal decided or closed, is not in it. -->
    <genericPageProvider name="payers_open_appeals"
        class="org.nuxeo.ecm.platform.query.nxql.SearchServicePageProvider">
      <searchDocumentType>PayersClaimSearch</searchDocumentType>
      <whereClause>
        <fixedPart>
          ecm:primaryType = 'Case' AND case:category = 'appeal'
          AND case:state IN ('open', 'inReview')
          AND ecm:isVersion = 0 AND ecm:isProxy = 0 AND ecm:isTrashed = 0
        </fixedPart>
      </whereClause>
      <aggregates>
        <aggregate id="case_state_agg" type="terms" parameter="case:state">
          <field schema="payers_claim_search" name="case_state_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
        <aggregate id="case_assignee_agg" type="terms" parameter="case:assignee">
          <field schema="payers_claim_search" name="case_assignee_agg" />
          <properties>
            <property name="size">10</property>
          </properties>
        </aggregate>
      </aggregates>
      <sort column="case:due" ascending="true" />
      <pageSize>50</pageSize>
      <maxPageSize>100</maxPageSize>
    </genericPageProvider>
  </extension>
</component>
