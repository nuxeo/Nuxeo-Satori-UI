{
  "$schema": "../../../../../../../libs/shared/app-definition/src/layout-v2.schema.json",
  "version": 2,
  "columns": 2,
  "cards": [
    {
      "id": "case",
      "labelKey": "payers.case.card",
      "fields": [
        "case:number",
        "case:category",
        {
          "field": "case:state",
          "widget": "status-badge",
          "parameters": {
            "tones": {
              "open": "info",
              "inReview": "warning",
              "decided": "positive",
              "closed": "neutral"
            }
          }
        },
        {
          "field": "case:decision",
          "widget": "status-badge",
          "parameters": { "tones": { "upheld": "neutral", "overturned": "positive" } },
          "visibleWhen": {
            "type": "app.rules.fieldIn",
            "parameters": [{ "field": "case:state" }, "decided", "closed"]
          }
        },
        {
          "field": "case:member",
          "widget": "document-link",
          "parameters": { "types": ["Member"] }
        },
        { "field": "case:claim", "widget": "document-link", "parameters": { "types": ["Claim"] } },
        { "field": "case:assignee", "widget": "user" }
      ]
    },
    {
      "id": "dates",
      "labelKey": "payers.case.dates",
      "fields": [
        { "field": "case:received", "widget": "date", "parameters": { "format": "long" } },
        { "field": "case:due", "widget": "date", "parameters": { "format": "long" } },
        {
          "id": "daysOpen",
          "widget": "number",
          "labelKey": "payers.case.daysOpen",
          "computed": {
            "type": "core.dateDiff",
            "parameters": [{ "field": "case:received" }, "today", "days"]
          },
          "visibleWhen": {
            "type": "core.not",
            "parameters": [
              { "type": "app.rules.fieldIn", "parameters": [{ "field": "case:state" }, "closed"] }
            ]
          }
        }
      ]
    },
    {
      "id": "summary",
      "labelKey": "payers.case.summary",
      "span": 2,
      "fields": [{ "field": "case:summary", "widget": "long-text" }]
    },
    {
      "id": "checklist",
      "labelKey": "payers.appeal.checklist",
      "visibleWhen": {
        "type": "app.rules.fieldIn",
        "parameters": [{ "field": "case:category" }, "appeal"]
      },
      "checklist": {
        "field": "case:checklist",
        "tickable": true,
        "items": [
          { "id": "appealLetter", "labelKey": "payers.appeal.appealLetter" },
          { "id": "reviewerAssigned", "labelKey": "payers.appeal.reviewerAssigned" },
          { "id": "medicalRecords", "labelKey": "payers.appeal.medicalRecords" },
          { "id": "providerStatement", "labelKey": "payers.appeal.providerStatement" },
          { "id": "decisionLetter", "labelKey": "payers.appeal.decisionLetter" }
        ]
      }
    },
    {
      "id": "letters",
      "labelKey": "payers.letters.card",
      "related": {
        "pageProvider": "payers_record_letters",
        "parameters": [{ "field": "ecm:uuid" }],
        "columns": [
          "dc:title",
          "letter:language",
          { "field": "letter:writtenAt", "widget": "relative-date" }
        ],
        "rowActions": ["app.rowActions.download"]
      }
    },
    {
      "id": "history",
      "labelKey": "payers.case.history",
      "timeline": { "pageSize": 10 }
    }
  ]
}
