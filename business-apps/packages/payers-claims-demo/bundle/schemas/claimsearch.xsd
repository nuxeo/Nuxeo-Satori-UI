<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until the presales Payers model arrives: the search document of the kit's queues,
     the claim queues and, since 0.6.0, the open appeals, as default_search is the platform's. It is never saved. A queue's chosen facets are
     sent back as named parameters, each named after its aggregate, such as
     claim_status_agg=["pended"]; the server writes each into the field of the same name here, and
     the aggregate of that name reads its selection from it. So each field is named exactly as its
     aggregate is, in payers-claims-demo-model.xml. Replace it with theirs. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/payers-claims-demo/claimsearch"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/payers-claims-demo/claimsearch">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string" />
  </xs:simpleType>

  <!-- The claim statuses chosen in a queue's Status facet. -->
  <xs:element name="claim_status_agg" type="nxs:stringList" />
  <!-- The adjusters chosen in a queue's Adjuster facet. -->
  <xs:element name="claim_adjuster_agg" type="nxs:stringList" />
  <!-- Since 0.6.0, the open-appeals queue's: the case states chosen in its State facet, and the
       case specialists chosen in its Assigned to facet. The schema keeps its name, which the
       search document type names, so a server upgraded from 0.5.0 keeps both. -->
  <xs:element name="case_state_agg" type="nxs:stringList" />
  <xs:element name="case_assignee_agg" type="nxs:stringList" />
</xs:schema>
