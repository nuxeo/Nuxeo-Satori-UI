<?xml version="1.0" encoding="UTF-8"?>
<!-- The appeal review workflow's model, since 0.7.0: a document export, as the claims review's is
     (../PayersClaimReview/document.xml), so that RouteModelsZipImporter imports it at startup from
     bundle/data/PayersAppealReview.zip. The route model's name is this folder's: PayersAppealReview,
     a task's workflowModelName. It is started on an appeal, a Case of the category appeal opened
     against a denied claim. Fictional, like the rest of the kit. build-route-model.mjs writes the
     zip from this folder. -->
<document repository="default" id="PayersAppealReview">
  <system>
    <type>DocumentRoute</type>
    <path>PayersAppealReview</path>
    <lifecycle-state>validated</lifecycle-state>
    <lifecycle-policy>documentRouteElement</lifecycle-policy>
    <facet>DocumentRoute</facet>
    <facet>Orderable</facet>
    <facet>facet-var_PayersAppealReview</facet>
    <access-control/>
  </system>
  <schema xmlns:docrm="http://www.nuxeo.org/ecm/schemas/document_route_model" name="document_route_model"></schema>
  <schema xmlns:common="http://www.nuxeo.org/ecm/schemas/common/" name="common"></schema>
  <schema xmlns:var_PayersAppealReview="http://www.nuxeo.org/ecm/project/schemas/payers-claims-demo/var_PayersAppealReview" name="var_PayersAppealReview"></schema>
  <schema xmlns:dc="http://www.nuxeo.org/ecm/schemas/dublincore/" name="dublincore">
    <dc:title><![CDATA[Appeal review]]></dc:title>
    <dc:description><![CDATA[A member services specialist upholds or overturns the denial an appeal is against; overturning reopens the claim for a new determination.]]></dc:description>
  </schema>
  <schema xmlns:docri="http://www.nuxeo.org/ecm/schemas/document_route_instance/" name="document_route_instance">
    <docri:variablesFacet><![CDATA[facet-var_PayersAppealReview]]></docri:variablesFacet>
    <docri:availabilityFilter><![CDATA[filter@PayersAppealReview]]></docri:availabilityFilter>
  </schema>
</document>
