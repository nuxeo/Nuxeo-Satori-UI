<?xml version="1.0" encoding="UTF-8"?>
<!-- Start: a submitted claim is put in review, through the Payers lifecycle's review transition,
     and goes to the adjuster. Since 0.7.0 a denied claim is reopened, through its reopen
     transition, and goes to the adjuster for a new determination: an appeal's review starts it so
     when it overturns the denial (../../PayersAppealReview/decide/document.xml), and the
     availability filter lets only an administrator, or the system an appeal's chain runs as, start
     it on a denied claim. Any other claim is not determined: the workflow ends, with the refusal in
     the claim's history. So a claim is determined once a review, and a second workflow started on
     a claim whose first one runs, past the availability filter, changes nothing. The first
     transition that holds is the one followed. -->
<document repository="default" id="start">
  <system>
    <type>RouteNode</type>
    <path>PayersClaimReview/start</path>
    <lifecycle-state>validated</lifecycle-state>
    <lifecycle-policy>documentRouteElement</lifecycle-policy>
    <access-control/>
  </system>
  <schema xmlns:common="http://www.nuxeo.org/ecm/schemas/common/" name="common"></schema>
  <schema xmlns:dc="http://www.nuxeo.org/ecm/schemas/dublincore/" name="dublincore">
    <dc:title><![CDATA[Start]]></dc:title>
  </schema>
  <schema xmlns:rnode="http://www.nuxeo.org/ecm/schemas/route_node/" name="route_node">
    <rnode:nodeId><![CDATA[start]]></rnode:nodeId>
    <rnode:start><![CDATA[true]]></rnode:start>
    <rnode:stop><![CDATA[false]]></rnode:stop>
    <rnode:hasTask><![CDATA[false]]></rnode:hasTask>
    <rnode:executeOnlyFirstTransition><![CDATA[true]]></rnode:executeOnlyFirstTransition>
    <rnode:inputChain><![CDATA[]]></rnode:inputChain>
    <rnode:outputChain><![CDATA[]]></rnode:outputChain>
    <rnode:transitions>
      <transition>
        <name><![CDATA[review]]></name>
        <label><![CDATA[Put in review]]></label>
        <condition><![CDATA[Document.lifeCycle == "submitted"]]></condition>
        <chain><![CDATA[PayersClaimReview.Review]]></chain>
        <targetId><![CDATA[determine]]></targetId>
      </transition>
      <transition>
        <name><![CDATA[reopen]]></name>
        <label><![CDATA[Reopen a denied claim]]></label>
        <condition><![CDATA[Document.lifeCycle == "denied"]]></condition>
        <chain><![CDATA[PayersClaimReview.Reopen]]></chain>
        <targetId><![CDATA[determine]]></targetId>
      </transition>
      <transition>
        <name><![CDATA[notSubmitted]]></name>
        <label><![CDATA[Refused: the claim is neither submitted nor denied]]></label>
        <condition><![CDATA[true]]></condition>
        <chain><![CDATA[PayersClaimReview.RefuseStart]]></chain>
        <targetId><![CDATA[end]]></targetId>
      </transition>
    </rnode:transitions>
    <rnode:escalationRules/>
    <rnode:taskX><![CDATA[0]]></rnode:taskX>
    <rnode:taskY><![CDATA[0]]></rnode:taskY>
  </schema>
</document>
