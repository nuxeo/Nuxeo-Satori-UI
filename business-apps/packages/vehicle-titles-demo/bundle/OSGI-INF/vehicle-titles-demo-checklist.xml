<?xml version="1.0"?>
<!--
  STAND-IN, written by hand: what app-model cannot write, apart from the model component it
  writes, so that app-model may write that one again. The README's log says why it is by hand.

  - A vehicle deal's checklist of required documents, a list of complex values,
    vehicledeal_docs (vdocs:), in the shape layout version 2's checklist card reads: item, done,
    doneBy, doneOn. Added to the stand-in model's VehicleDeal type.

  Fictional, like the kit. Replaced with the stand-in model when a real one arrives.
-->
<component name="nuxeo.config.vehicle-titles-demo.checklist" version="1.0">
  <require>nuxeo.config.vehicle-titles-demo.model</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="vehicledeal_docs" prefix="vdocs" src="schemas/vehicledeal_docs.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <!-- Added to the stand-in model's type: its checklist of required documents. -->
    <doctype name="VehicleDeal" append="true">
      <schema name="vehicledeal_docs" />
    </doctype>
  </extension>
</component>
