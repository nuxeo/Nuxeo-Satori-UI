<?xml version="1.0" encoding="UTF-8"?>
<!-- STAND-IN, until a real model arrives: the fictional vehicledeal schema of the VehicleDeal type,
     written by the app-model generator. Replace it with the real one, and the layouts and the
     queues follow its property names. -->
<xs:schema
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/vehicle-titles-demo/vehicledeal"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/vehicle-titles-demo/vehicledeal">

  <xs:element name="number" type="xs:string" />
  <xs:element name="buyer" type="xs:string" />
  <xs:element name="buyerEmail" type="xs:string" />
  <xs:element name="buyerPhone" type="xs:string" />
  <xs:element name="vin" type="xs:string" />
  <xs:element name="year" type="xs:string" />
  <xs:element name="make" type="xs:string" />
  <xs:element name="model" type="xs:string" />
  <xs:element name="price" type="xs:double" />
  <xs:element name="financeType">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Cash" />
        <xs:enumeration value="Loan" />
        <xs:enumeration value="Lease" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="lender" type="xs:string" />
  <xs:element name="amountFinanced" type="xs:double" />
  <xs:element name="termMonths" type="xs:long" />
  <xs:element name="tradeIn" type="xs:boolean" />
  <xs:element name="tradeInVehicle" type="xs:string" />
  <xs:element name="tradeInVin" type="xs:string" />
  <xs:element name="tradeInAllowance" type="xs:double" />
  <xs:element name="tradeInPayoff" type="xs:double" />
  <xs:element name="tradeInTitle" type="xs:string" />
  <xs:element name="title" type="xs:string" />
  <xs:element name="status">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="Working" />
        <xs:enumeration value="Contracted" />
        <xs:enumeration value="Funded" />
        <xs:enumeration value="Delivered" />
        <xs:enumeration value="Cancelled" />
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="salesperson" type="xs:string" />
  <xs:element name="financeManager" type="xs:string" />
  <xs:element name="soldOn" type="xs:date" />
  <xs:element name="deliveredOn" type="xs:date" />
  <xs:element name="notes" type="xs:string" />
</xs:schema>
