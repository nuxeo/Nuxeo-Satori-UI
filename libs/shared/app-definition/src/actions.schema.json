{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxeo-satori:app-definition:actions:2",
  "title": "actions.json, app definition version 2",
  "description": "docs/business-apps/app-definition-v2.md, section 5. The validator in libs/shared/app-definition is what refuses a package. It also checks what a schema cannot: that ids are unique, that each operation is on the deployment's allow-list, and that a bulk action's parameters are literals.",
  "type": "object",
  "required": ["version", "actions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "not": {
                "pattern": "^(?:app|core)\\."
              }
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "order": {
          "type": "integer"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["record", "row", "bulk"]
          }
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "transition": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "description": "Must be on the deployment's allow-list."
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "confirm": {
          "$ref": "#/$defs/message"
        },
        "success": {
          "$ref": "#/$defs/message"
        },
        "refresh": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["label"]
            },
            {
              "required": ["labelKey"]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["transition"],
              "not": {
                "anyOf": [
                  {
                    "required": ["operation"]
                  },
                  {
                    "required": ["parameters"]
                  }
                ]
              }
            },
            {
              "required": ["operation"],
              "not": {
                "required": ["transition"]
              }
            }
          ]
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["labelKey"]
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "xpath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "rule": {
      "description": "A registered rule (extension-reference.md, section 4), or a customer's own, registered in code.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "parameters": {
              "type": "array"
            }
          }
        }
      ]
    },
    "fieldReference": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/fieldReference"
        },
        {
          "type": "object",
          "required": ["computed"],
          "additionalProperties": false,
          "properties": {
            "computed": {
              "$ref": "#/$defs/computation"
            }
          }
        }
      ]
    },
    "computation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "core.age",
            "core.template",
            "core.sum",
            "core.count",
            "core.dateDiff",
            "core.choose"
          ]
        },
        "parameters": {
          "type": "array"
        }
      }
    }
  }
}
