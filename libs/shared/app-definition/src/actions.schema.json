{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxeo-satori:app-definition:actions:2",
  "title": "actions.json, app definition version 2",
  "description": "docs/business-apps/app-definition-v2.md, section 5. The validator in libs/shared/app-definition is what refuses a package. It also checks what a schema cannot: that ids are unique, that each operation is on the deployment's allow-list, that a bulk action's parameters are literals, that each var: parameter names a field of the action's form and each field of the form is sent, and each form field as a task form's (layout-v2.md). On a server, the app registry serves only the actions the server's own allow-list lets run.",
  "type": "object",
  "required": ["version", "actions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The address of this JSON Schema, for editors. Ignored otherwise."
    },
    "version": {
      "const": 2
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "not": {
                "pattern": "^(?:app|core)\\."
              }
            }
          ]
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "order": {
          "type": "integer"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["record", "row", "bulk"]
          }
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "enabledWhen": {
          "$ref": "#/$defs/rule",
          "description": "While it does not pass, the button shows and cannot be chosen. Checked again before the action runs."
        },
        "transition": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "description": "Must be on the deployment's allow-list."
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameterValue"
          }
        },
        "form": {
          "type": "array",
          "minItems": 1,
          "description": "The fields the person fills in before it runs, each var:<name>, drawn as a task form's (layout-v2.md). A parameter { \"field\": \"var:<name>\" } sends what is entered.",
          "items": {
            "$ref": "#/$defs/formField"
          }
        },
        "confirm": {
          "$ref": "#/$defs/message"
        },
        "success": {
          "$ref": "#/$defs/message"
        },
        "refresh": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["label"]
            },
            {
              "required": ["labelKey"]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["transition"],
              "not": {
                "anyOf": [
                  {
                    "required": ["operation"]
                  },
                  {
                    "required": ["parameters"]
                  },
                  {
                    "required": ["form"]
                  }
                ]
              }
            },
            {
              "required": ["operation"],
              "not": {
                "required": ["transition"]
              }
            }
          ]
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["labelKey"]
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "xpath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "rule": {
      "description": "A registered rule (extension-reference.md, section 4), or a customer's own, registered in code.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "parameters": {
              "type": "array"
            }
          }
        }
      ]
    },
    "fieldReference": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        }
      }
    },
    "parameterValue": {
      "description": "A literal, a field of the record, or a field of the action's form, var:<name>. Not a computation: it is worked out in the browser, which the server does not trust.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/fieldReference"
        }
      ]
    },
    "formFieldName": {
      "type": "string",
      "pattern": "^var:[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "formField": {
      "description": "A field of a task form (layout-v2.md, section 5) whose field is var:<name>.",
      "oneOf": [
        {
          "$ref": "#/$defs/formFieldName"
        },
        {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/formFieldName"
            },
            "label": {
              "type": "string"
            },
            "labelKey": {
              "type": "string"
            },
            "widget": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "description": "The widget's parameters (layout-v2.md, section 3)."
            },
            "visibleWhen": {
              "$ref": "#/$defs/rule"
            },
            "required": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/rule"
                }
              ]
            },
            "readOnlyWhen": {
              "$ref": "#/$defs/rule"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
