{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxeo-satori:app-definition:layout:2",
  "title": "Layout file version 2",
  "description": "docs/business-apps/layout-v2.md. A task form, tasks/<workflow>.<step>.layout.json, is a layout file too (app-definition-v2.md, section 6). Editors, the designer and the agent read this schema. The validator in libs/shared/app-definition is what refuses a package, and it also checks what a schema cannot: that ids are unique, which keys a mode allows, each widget's parameters and each computation's signature, and a task form's var: fields.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The address of this JSON Schema, for editors. Ignored otherwise."
    },
    "version": {
      "const": 2
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "View mode only."
    },
    "banners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/banner"
      },
      "description": "View mode only. Shown above the cards, each while its rule passes."
    },
    "review": {
      "$ref": "#/$defs/review",
      "description": "View mode only. A picture's record page shows its picture as a review: pins on the view shown, each with a note, in rounds."
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tab"
      }
    }
  },
  "oneOf": [
    {
      "required": ["cards"],
      "not": {
        "required": ["tabs"]
      }
    },
    {
      "required": ["tabs"],
      "not": {
        "required": ["cards"]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "xpath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "description": "No options yet: {} turns the review on. Drawn only for a record with the picture schema and not the video one; the content model, when given, holds the type to that."
    },
    "banner": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "tone": {
          "enum": ["info", "warning", "negative"],
          "description": "Default info."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "link": {
          "$ref": "#/$defs/bannerLink"
        }
      },
      "description": "A message about the record, above its cards. It needs a label or a labelKey.",
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["labelKey"]
        }
      ]
    },
    "bannerLink": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath",
          "description": "A property of the open record holding a record's id. The banner shows that record by its title, as a document-link does, and opens it."
        }
      },
      "description": "The record the banner links to."
    },
    "tab": {
      "type": "object",
      "required": ["id", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "View mode only, and no more than the file's columns."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "related": {
          "$ref": "#/$defs/related"
        },
        "timeline": {
          "$ref": "#/$defs/timeline"
        },
        "comments": {
          "$ref": "#/$defs/comments"
        },
        "external": {
          "$ref": "#/$defs/external"
        },
        "checklist": {
          "$ref": "#/$defs/checklist"
        }
      },
      "description": "A card shows one of fields, related records, a timeline, comments, fields from another system or a checklist.",
      "oneOf": [
        {
          "required": ["fields"]
        },
        {
          "required": ["related"]
        },
        {
          "required": ["timeline"]
        },
        {
          "required": ["comments"]
        },
        {
          "required": ["external"]
        },
        {
          "required": ["checklist"]
        }
      ]
    },
    "fieldEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/xpath"
        },
        {
          "$ref": "#/$defs/field"
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        },
        "computed": {
          "$ref": "#/$defs/computation"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "widget": {
          "enum": [
            "text",
            "long-text",
            "rich-text",
            "number",
            "currency",
            "percent",
            "date",
            "relative-date",
            "boolean",
            "phone",
            "email",
            "address",
            "user",
            "group",
            "vocabulary",
            "document-link",
            "chips",
            "status-badge",
            "table",
            "image",
            "file-list"
          ]
        },
        "parameters": {
          "type": "object",
          "description": "The widget's parameters (layout-v2.md, section 3)."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "required": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "description": "Edit and create forms only."
        },
        "readOnlyWhen": {
          "$ref": "#/$defs/rule",
          "description": "Edit and create forms only."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "description": "Edit and create forms only."
        }
      },
      "oneOf": [
        {
          "required": ["field"],
          "not": {
            "required": ["computed"]
          }
        },
        {
          "required": ["computed", "id"],
          "not": {
            "required": ["field"]
          }
        }
      ]
    },
    "rule": {
      "description": "A registered rule (extension-reference.md, section 4), or a customer's own, registered in code.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "parameters": {
              "type": "array"
            }
          }
        }
      ]
    },
    "fieldReference": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/fieldReference"
        },
        {
          "type": "object",
          "required": ["computed"],
          "additionalProperties": false,
          "properties": {
            "computed": {
              "$ref": "#/$defs/computation"
            }
          }
        }
      ]
    },
    "computation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "core.age",
            "core.template",
            "core.sum",
            "core.count",
            "core.dateDiff",
            "core.choose"
          ]
        },
        "parameters": {
          "type": "array"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["core.notBefore", "core.atMost"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "object",
      "required": ["pageProvider", "columns"],
      "additionalProperties": false,
      "description": "View mode only.",
      "properties": {
        "pageProvider": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/fieldReference"
              }
            ]
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/$defs/xpath"
              },
              "order": {
                "enum": ["asc", "desc"]
              }
            }
          }
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rowActions": {
          "type": "array",
          "items": {
            "enum": [
              "app.rowActions.download",
              "app.rowActions.rename",
              "app.rowActions.copyTo",
              "app.rowActions.moveTo",
              "app.rowActions.delete"
            ]
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "description": "View mode only. The record's history from the server's audit, newest first.",
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "description": "The audit events it shows, by ID, such as documentModified. Without it, the record's own changes (layout-v2.md, section 7).",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "filter": {
          "type": "boolean",
          "description": "Offers the reader a filter by kind of event. Default false."
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "description": "View mode only. The record's comments and their replies.",
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "external": {
      "type": "object",
      "required": ["connector", "fields"],
      "additionalProperties": false,
      "description": "View mode only. Fields of a record in another system, read on the server through a connector it registers (nuxeo-agentic-connectors). The connector's address, key and credential are the server's configuration: no text in this card may look like an address.",
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "description": "The id of a connector the server registers."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/externalFieldName"
              },
              {
                "$ref": "#/$defs/externalField"
              }
            ]
          }
        }
      }
    },
    "externalFieldName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "description": "A field the connector's allow-list returns, by its name."
    },
    "externalField": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/externalFieldName"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "widget": {
          "enum": [
            "text",
            "long-text",
            "number",
            "currency",
            "percent",
            "date",
            "relative-date",
            "boolean",
            "status-badge"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "checklist": {
      "type": "object",
      "required": ["field", "items"],
      "additionalProperties": false,
      "description": "View mode only. The items a record must have done, in order, each shown done or not, with who and when, from one of the record's properties. Read-only: the card ticks nothing.",
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath",
          "description": "The record's property that holds each item's state: a list of complex values with the subfields item (text), done (boolean), doneBy (a user name) and doneOn (a date). Never an ecm: or var: name."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/checklistItem"
          }
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "description": "One required item. It needs a label or a labelKey.",
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["labelKey"]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "What the property's item subfield holds for this item. Unique in its checklist."
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      }
    }
  }
}
