{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxeo-satori:app-definition:layout:2",
  "title": "Layout file version 2",
  "description": "docs/business-apps/layout-v2.md. A task form, tasks/<workflow>.<step>.layout.json, is a layout file too (app-definition-v2.md, section 6). Editors, the designer and the agent read this schema. The validator in libs/shared/app-definition is what refuses a package, and it also checks what a schema cannot: that ids are unique, which keys a mode allows, each widget's parameters and each computation's signature, and a task form's var: fields.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "View mode only."
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tab"
      }
    }
  },
  "oneOf": [
    {
      "required": ["cards"],
      "not": {
        "required": ["tabs"]
      }
    },
    {
      "required": ["tabs"],
      "not": {
        "required": ["cards"]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "xpath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "tab": {
      "type": "object",
      "required": ["id", "cards"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "View mode only, and no more than the file's columns."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "related": {
          "$ref": "#/$defs/related"
        }
      },
      "oneOf": [
        {
          "required": ["fields"],
          "not": {
            "required": ["related"]
          }
        },
        {
          "required": ["related"],
          "not": {
            "required": ["fields"]
          }
        }
      ]
    },
    "fieldEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/xpath"
        },
        {
          "$ref": "#/$defs/field"
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        },
        "computed": {
          "$ref": "#/$defs/computation"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "widget": {
          "enum": [
            "text",
            "long-text",
            "rich-text",
            "number",
            "currency",
            "percent",
            "date",
            "relative-date",
            "boolean",
            "phone",
            "email",
            "address",
            "user",
            "group",
            "vocabulary",
            "document-link",
            "chips",
            "status-badge",
            "table",
            "image",
            "file-list"
          ]
        },
        "parameters": {
          "type": "object",
          "description": "The widget's parameters (layout-v2.md, section 3)."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "required": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "description": "Edit and create forms only."
        },
        "readOnlyWhen": {
          "$ref": "#/$defs/rule",
          "description": "Edit and create forms only."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "description": "Edit and create forms only."
        }
      },
      "oneOf": [
        {
          "required": ["field"],
          "not": {
            "required": ["computed"]
          }
        },
        {
          "required": ["computed", "id"],
          "not": {
            "required": ["field"]
          }
        }
      ]
    },
    "rule": {
      "description": "A registered rule (extension-reference.md, section 4), or a customer's own, registered in code.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "parameters": {
              "type": "array"
            }
          }
        }
      ]
    },
    "fieldReference": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/fieldReference"
        },
        {
          "type": "object",
          "required": ["computed"],
          "additionalProperties": false,
          "properties": {
            "computed": {
              "$ref": "#/$defs/computation"
            }
          }
        }
      ]
    },
    "computation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "core.age",
            "core.template",
            "core.sum",
            "core.count",
            "core.dateDiff",
            "core.choose"
          ]
        },
        "parameters": {
          "type": "array"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["core.notBefore", "core.atMost"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      }
    },
    "related": {
      "type": "object",
      "required": ["pageProvider", "columns"],
      "additionalProperties": false,
      "description": "View mode only.",
      "properties": {
        "pageProvider": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/fieldReference"
              }
            ]
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldEntry"
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/$defs/xpath"
              },
              "order": {
                "enum": ["asc", "desc"]
              }
            }
          }
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rowActions": {
          "type": "array",
          "items": {
            "enum": [
              "app.rowActions.download",
              "app.rowActions.rename",
              "app.rowActions.copyTo",
              "app.rowActions.moveTo",
              "app.rowActions.delete"
            ]
          }
        }
      }
    }
  }
}
