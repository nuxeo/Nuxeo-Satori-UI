{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nuxeo-satori:app-definition:queue:2",
  "title": "A queue, queues/<id>.json, app definition version 2",
  "description": "docs/business-apps/app-definition-v2.md, section 4. The validator in libs/shared/app-definition is what refuses a package. It also checks what a schema cannot: that ids are unique, each widget's parameters and each computation's signature, and that the row and bulk actions are the platform's or the package's own.",
  "type": "object",
  "required": ["version", "pageProvider", "columns"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The address of this JSON Schema, for editors. Ignored otherwise."
    },
    "version": {
      "const": 2
    },
    "label": {
      "type": "string"
    },
    "labelKey": {
      "type": "string"
    },
    "pageProvider": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": ["string", "number", "boolean"]
      },
      "description": "Literals: a queue has no open record."
    },
    "search": {
      "$ref": "#/$defs/search"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fieldEntry"
      }
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field"],
        "additionalProperties": false,
        "properties": {
          "field": {
            "$ref": "#/$defs/xpath"
          },
          "order": {
            "enum": ["asc", "desc"]
          }
        }
      }
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "facets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/facet"
      }
    },
    "rowActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "description": "The platform's row actions, or the package's own from actions.json."
    },
    "bulkActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "description": "The platform's bulk actions, or the package's own from actions.json."
    },
    "visibleWhen": {
      "$ref": "#/$defs/rule"
    }
  },
  "anyOf": [
    {
      "required": ["label"]
    },
    {
      "required": ["labelKey"]
    }
  ],
  "$defs": {
    "facet": {
      "type": "object",
      "required": ["aggregate"],
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "widget": {
          "enum": ["document-link", "user", "group"],
          "description": "document-link, for an aggregate on a reference: each bucket, a record's id, shown by that record's title; user or group, for an aggregate on user or group names: each bucket shown by the display name (app-definition-v2.md, section 4)."
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "description": "A text field above the list, and a Search button. The text, trimmed, is the page provider's last parameter, after the queue's own; the list is drawn once something is searched for. With \"open\": \"single\", a search that finds one record alone opens it, as a scanned barcode opens its item (app-definition-v2.md, section 4).",
      "properties": {
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "open": {
          "enum": ["single"]
        }
      },
      "anyOf": [
        {
          "required": ["label"]
        },
        {
          "required": ["labelKey"]
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "xpath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "fieldEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/xpath"
        },
        {
          "$ref": "#/$defs/field"
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        },
        "computed": {
          "$ref": "#/$defs/computation"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "widget": {
          "enum": [
            "text",
            "long-text",
            "rich-text",
            "number",
            "currency",
            "percent",
            "date",
            "relative-date",
            "boolean",
            "phone",
            "email",
            "address",
            "user",
            "group",
            "vocabulary",
            "document-link",
            "chips",
            "status-badge",
            "table",
            "image",
            "file",
            "file-list"
          ]
        },
        "parameters": {
          "type": "object",
          "description": "The widget's parameters (layout-v2.md, section 3)."
        },
        "visibleWhen": {
          "$ref": "#/$defs/rule"
        },
        "required": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "description": "Edit and create forms only."
        },
        "readOnlyWhen": {
          "$ref": "#/$defs/rule",
          "description": "Edit and create forms only."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "description": "Edit and create forms only."
        }
      },
      "oneOf": [
        {
          "required": ["field"],
          "not": {
            "required": ["computed"]
          }
        },
        {
          "required": ["computed", "id"],
          "not": {
            "required": ["field"]
          }
        }
      ]
    },
    "rule": {
      "description": "A registered rule (extension-reference.md, section 4), or a customer's own, registered in code.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "parameters": {
              "type": "array"
            }
          }
        }
      ]
    },
    "fieldReference": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/xpath"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/fieldReference"
        },
        {
          "type": "object",
          "required": ["computed"],
          "additionalProperties": false,
          "properties": {
            "computed": {
              "$ref": "#/$defs/computation"
            }
          }
        }
      ]
    },
    "computation": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "core.age",
            "core.template",
            "core.sum",
            "core.count",
            "core.dateDiff",
            "core.choose"
          ]
        },
        "parameters": {
          "type": "array"
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["core.notBefore", "core.atMost"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "label": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      }
    }
  }
}
