{
  "version": 2,
  "label": "Documents",
  "cards": [
    {
      "id": "all",
      "label": "Documents",
      "kpi": { "pageProvider": "default_search" },
      "queue": "documents"
    },
    {
      "id": "contracts",
      "label": "Contracts",
      "kpi": {
        "pageProvider": "default_search",
        "aggregate": "dc_nature_agg",
        "bucket": "contract"
      },
      "visibleWhen": { "type": "app.rules.inGroup", "parameters": ["members", "administrators"] }
    },
    {
      "id": "by-nature",
      "label": "By nature",
      "kpi": { "pageProvider": "default_search", "aggregate": "dc_nature_agg" },
      "visibleWhen": { "type": "app.rules.inGroup", "parameters": ["members", "administrators"] }
    },
    {
      "id": "by-author",
      "label": "By author",
      "kpi": { "pageProvider": "default_search", "aggregate": "dc_creator_agg" },
      "visibleWhen": { "type": "app.rules.inGroup", "parameters": ["administrators"] }
    },
    {
      "id": "my-tasks",
      "tasks": { "limit": 5 }
    },
    {
      "id": "recent-notes",
      "label": "Recent notes and files",
      "recent": { "types": ["Note", "File"], "limit": 5 }
    }
  ]
}
