{
  "name": "satori-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/satori-components/src",
  "prefix": "nxs",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "compodoc": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production"],
      "outputs": ["{projectRoot}/documentation.json"],
      "options": {
        "command": "compodoc -p libs/shared/satori-components/tsconfig.lib.json -e json -d libs/shared/satori-components --disablePrivate --disableProtected --disableInternal --disableLifeCycleHooks --disableSourceCode --disableTemplateTab --disableStyleTab"
      },
      "$comment": "Writes the gitignored `documentation.json` the API pages are read from, leaving out private, protected, `@internal` and lifecycle members and the source, templates and styles Storybook does not read. `typecheck`, `storybook` and `build-storybook` depend on it, so the arguments are written once and `typecheck` compares the shape in `.storybook/compodoc.ts` with the JSON Compodoc writes; no declaration stands in for a missing file."
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["compodoc"],
      "inputs": ["default", "^default"],
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/shared/satori-components"],
      "options": {
        "command": "ngc -p libs/shared/satori-components/tsconfig.lib.json --outDir dist/out-tsc/libs/shared/satori-components && tsc -p libs/shared/satori-components/.storybook/tsconfig.json --noEmit"
      },
      "$comment": "The second half type-checks the stories and the `.storybook/` sources, which `tsconfig.lib.json` excludes and Vitest never compiles."
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/shared/satori-components"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "dependsOn": ["compodoc"],
      "options": {
        "port": 6006,
        "configDir": "libs/shared/satori-components/.storybook",
        "browserTarget": "satori-components:build-storybook",
        "experimentalZoneless": true,
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "satori": {
          "browserTarget": "satori-components:build-storybook:satori"
        }
      },
      "$comment": "`experimentalZoneless` is read from this target's own options, not from `browserTarget`; without it the dev server loads Zone.js under the zoneless providers in `preview.ts` (NG0914). Compodoc runs once, as the `compodoc` target, before the server starts: restart the server to see an input's new JSDoc on its API page."
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "dependsOn": ["compodoc"],
      "outputs": ["{options.outputDir}"],
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        "{workspaceRoot}/apps/nuxeo-ui/public/i18n/**/*"
      ],
      "options": {
        "outputDir": "dist/storybook/satori-components",
        "configDir": "libs/shared/satori-components/.storybook",
        "browserTarget": "satori-components:build-storybook",
        "tsConfig": "libs/shared/satori-components/.storybook/tsconfig.json",
        "styles": ["libs/shared/satori-components/.storybook/material-theme.scss"],
        "experimentalZoneless": true,
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "satori": {
          "outputDir": "dist/storybook/satori-components-satori-theme",
          "styles": ["libs/shared/satori-components/.storybook/satori-theme.scss"]
        }
      },
      "$comment": "The default configuration needs no GitHub Packages token: `checkSatoriComponentsDependencies` reads `options.styles` and the files under `.storybook/`, and CI builds it with `@hylandsoftware` and `@alfresco` removed from node_modules. `:satori` is the product theme and needs `@hylandsoftware/satori-ui` installed."
    }
  }
}
