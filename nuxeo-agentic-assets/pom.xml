<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.nuxeo.agentic</groupId>
    <artifactId>nuxeo-agentic-ui-parent</artifactId>
    <version>2026.0.2-SNAPSHOT</version>
  </parent>

  <artifactId>nuxeo-agentic-assets</artifactId>
  <name>Nuxeo Agentic Assets</name>
  <description>
    The assets module's server add-on: an asset's rights enforced on the server, and its share
    links. Its download permission refuses the original, a picture view or a rendition that an
    asset's rights do not cover, and its assetRights enricher says why. A share link serves the
    picture views it lists, watermarked on the server, to anyone holding its token, while the link
    and the asset's rights both hold. Media rights: an asset's territories and release windows, a
    localised version reading its film's windows, and a delivery package refused whole outside
    them. Since 0.5.0, watermarks a rights policy requires, and an asset's review decided on the
    server, held to the add-on's ReviewAsset permission and audited. Its own Marketplace package,
    beside nuxeo-agentic-core: one add-on per domain module (decision B's recommendation).
  </description>

  <properties>
    <!--
      The Marketplace package's version, its own: the add-on is released apart from
      nuxeo-agentic-ui, and a package depends on it by this version. The manifest's Bundle-Version
      repeats it, and AddonPackageTest refuses a build where the two differ.
    -->
    <assets.package.version>0.6.0</assets.package.version>
  </properties>

  <!--
    The Nuxeo test framework's runtime starts Nuxeo Stream on Chronicle Queue, and 11.5's Chronicle,
    core 2.20.21, looks for a JDK method Java 21 no longer has (FileChannelImpl.unmap0), so the
    runtime does not start. The last releases of the same 2.20 line find it where Java 21 keeps it,
    as nuxeo-agentic-documents does. Only the tests load Chronicle: the bundle uses none of it.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-core</artifactId>
        <version>2.25ea15</version>
      </dependency>
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-bytes</artifactId>
        <version>2.25ea11</version>
      </dependency>
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-wire</artifactId>
        <version>2.25ea16</version>
      </dependency>
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-threads</artifactId>
        <version>2.25ea7</version>
      </dependency>
      <dependency>
        <groupId>net.openhft</groupId>
        <artifactId>chronicle-queue</artifactId>
        <version>5.25ea17</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The enricher API (AbstractJsonEnricher). The download permission needs no class from it. -->
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-io</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.runtime</groupId>
      <artifactId>nuxeo-runtime</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Share links: the operations signed-in users manage them with. -->
    <dependency>
      <groupId>org.nuxeo.ecm.automation</groupId>
      <artifactId>nuxeo-automation-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Share links and their downloads are kept in two directories, as Nuxeo keeps its own tokens. -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-directory-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- A link's creator, with their groups, to ask whether they may still share the asset. -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-usermanager</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The share links' servlet. Nuxeo LTS 2025 is on Jakarta Servlet 6, while the 11.5 artifacts
      Maven resolves for the rest are on javax: nuxeo-agentic-core names it the same way.
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.common</groupId>
      <artifactId>nuxeo-common</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Since 0.5.0, a review decision's entry in the platform's audit: AuditLogger and LogEntry,
      reached through AuditAccess, as the documents and records add-ons reach them.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-audit-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Since 0.5.0, a watermarked rendition: the rendition service, read to mark a rendition a
      policy lists, such as a picture's thumbnail, with the reader's name.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-rendition-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      The platform's Video.* operations, which the add-on replaces by operations of the same ids
      that ask the rights first, then run the platform's own. Every class named is in the same
      jar, with the same fields and methods, on the local Nuxeo LTS 2025.10.18 server.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-video</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Since 0.6.0, a long video marked in the background: the work manager's AbstractWork and
      WorkManager, and the key/value store a job's lease, marker and failure are kept in, with the
      same names and signatures on the local Nuxeo LTS 2025.10.18 server, as the connectors add-on
      uses them.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-event</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.runtime</groupId>
      <artifactId>nuxeo-runtime-kv</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <!--
      The Nuxeo test framework, for what needs a real runtime and repository: VCS on H2, the
      platform's download service evaluating the contributed permission, its Automation service,
      and its Video type and operations (VideoRightsTest). Its runner is JUnit 4's, which the
      vintage engine runs beside the Jupiter tests.
    -->
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-storage-sql-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.runtime</groupId>
      <artifactId>nuxeo-runtime-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Since 0.5.0, the review's tests: Nuxeo's comment bundle for its Annotation and CommentRoot
      types only, which the review's annotations are (the tests write one as the platform's comment
      manager does, ReviewAnnotations says how); the user manager with its test directories, for a
      reviewer's groups (PlatformFeature); and the platform's audit, its service, its listener and
      its store, an H2 database, as the documents add-on's tests run it.
    -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-comment</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-audit-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-audit-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- The tags' facet, which the platform's Video type has. -->
    <dependency>
      <groupId>org.nuxeo.ecm.platform</groupId>
      <artifactId>nuxeo-platform-tag</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      FeaturesRunner orders a test's methods by reading its class with ASM, and 11.5 brings ASM 9.0,
      which reads class files up to Java 16's. The tests are Java 21's, so a later ASM, for the
      tests only.
    -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.7</version>
      <scope>test</scope>
    </dependency>
    <!-- Chronicle Threads 2.25 needs it, and 11.5's dependency management leaves it out. -->
    <dependency>
      <groupId>net.openhft</groupId>
      <artifactId>affinity</artifactId>
      <version>3.23.3</version>
      <scope>test</scope>
    </dependency>
    <!--
      The script engine Nuxeo LTS 2025 evaluates download permissions with: nashorn-core 15.7, as
      the container's nxserver/lib holds it. DownloadPermissionScriptTest runs the contributed
      script through it the way DownloadServiceImpl.checkPermission does.
    -->
    <dependency>
      <groupId>org.openjdk.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>15.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifestFile>src/main/resources/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <assets.package.version>${assets.package.version}</assets.package.version>
            <!-- As the server runs: the watermark draws with no display. -->
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <!--
            The test runtime starts Nuxeo Stream on Chronicle, which reaches into the JDK's internals:
            on Java 17 and later they must be opened to it, as Nuxeo LTS 2023 and 2025 do in their
            own launcher.
          -->
          <argLine>
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens=jdk.compiler/com.sun.tools.javac=ALL-UNNAMED
            --add-exports=java.base/jdk.internal.ref=ALL-UNNAMED
            --add-exports=java.base/jdk.internal.misc=ALL-UNNAMED
            --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
            --add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>

      <!-- package.xml with its version, for the Marketplace package. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <!--
            The brand assets kit's own video policy, into the test bundle, so that VideoRightsTest
            deploys the file the kit ships, as it is, rather than a copy that could drift from it;
            and, since 0.5.0, its review policy, for AssetReviewTest.
          -->
          <execution>
            <id>kit-video-policy</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}/OSGI-INF/kit</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../business-apps/packages/brand-assets-demo/bundle/OSGI-INF</directory>
                  <includes>
                    <include>brand-assets-demo-video-rights.xml</include>
                    <!-- Since 0.5.0: the kit's review policy, which AssetReviewTest decides on. -->
                    <include>brand-assets-demo-review.xml</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!--
            The media kit's own rights policy and schemas, into the test bundle, so that
            MediaDeliveryTest decides on the policy the kit ships and the fields it declares, as
            they are. Its model component requires org.nuxeo.runtime.started, which the test
            runtime does not have, so the test registers the kit's schemas in a component of its
            own, which KitMediaModelTest holds to the kit's.
          -->
          <execution>
            <id>kit-media-policy</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}/OSGI-INF/kit</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../business-apps/packages/media-demo/bundle/OSGI-INF</directory>
                  <includes>
                    <include>media-demo-rights.xml</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>kit-media-schemas</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}/schemas/kit</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../business-apps/packages/media-demo/bundle/schemas</directory>
                  <includes>
                    <include>film.xsd</include>
                    <include>filmversion.xsd</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>filter-package-descriptor</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/package</outputDirectory>
              <useDefaultDelimiters>false</useDefaultDelimiters>
              <delimiters>
                <delimiter>@</delimiter>
              </delimiters>
              <resources>
                <resource>
                  <directory>src/main/package</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The Marketplace package: package.xml, install.xml and the bundle. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptors>
            <descriptor>src/main/assemble/assembly.xml</descriptor>
          </descriptors>
          <finalName>nuxeo-agentic-assets-${assets.package.version}</finalName>
          <appendAssemblyId>false</appendAssemblyId>
          <attach>false</attach>
        </configuration>
        <executions>
          <execution>
            <id>marketplace-package</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
