<?xml version="1.0"?>
<!-- A stand-in for the brand assets kit's picture type, as much of it as its review and a watermark
     read: an AcmeAsset that extends the platform's Picture, with the acmeasset schema's channels.
     Its rights end is dc:expired, which Picture has. -->
<component name="org.nuxeo.agentic.assets.test.asset-model">

  <require>org.nuxeo.ecm.platform.picture.coreTypes</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="acmeasset" src="schemas/test-acmeasset.xsd" prefix="acmeasset" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="AcmeAsset" extends="Picture">
      <schema name="acmeasset" />
    </doctype>
  </extension>

</component>
