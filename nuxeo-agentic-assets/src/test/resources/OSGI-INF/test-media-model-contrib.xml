<?xml version="1.0"?>
<!-- The media kit's stand-in model, for the test runtime: the kit's own schemas, which the build
     copies from the kit (the pom's kit-media-schemas), under the kit's types. The kit's component
     requires org.nuxeo.runtime.started, which the test runtime does not have, so its types are
     registered here; KitMediaModelTest holds them to the kit's model file. -->
<component name="org.nuxeo.agentic.assets.test.media-model">

  <require>org.nuxeo.ecm.core.CoreExtensions</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="film" prefix="film" src="schemas/kit/film.xsd" />
    <schema name="filmversion" prefix="fver" src="schemas/kit/filmversion.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="Film" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="film" />
    </doctype>
    <doctype name="FilmVersion" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="files" />
      <schema name="filmversion" />
    </doctype>
  </extension>

</component>
