<?xml version="1.0"?>
<!-- A type that is not a film and holds a film's release windows all the same: what a version
     naming it for its windows must be refused, since its policy's <windows type> is Film. -->
<component name="org.nuxeo.agentic.assets.test.media-other">

  <require>org.nuxeo.agentic.assets.test.media-model</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="NotAFilm" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="film" />
    </doctype>
  </extension>

</component>
