<?xml version="1.0" encoding="UTF-8"?>
<!-- The tests refuse on purpose, and the add-on logs each refusal and each unreadable policy: keep
     those out of the build output. A test asserts the decision, never the log. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="%-5p [%c{1}] %m%n" />
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.nuxeo.agentic.assets" level="off" />
    <Root level="warn">
      <AppenderRef ref="console" />
    </Root>
  </Loggers>
</Configuration>
