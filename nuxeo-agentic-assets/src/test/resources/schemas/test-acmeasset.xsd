<?xml version="1.0" encoding="UTF-8"?>
<!-- The stand-in's channels, as the kit's acmeasset schema has them: a list of text. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/agentic-assets-test/acmeasset"
           targetNamespace="http://www.nuxeo.org/ecm/project/schemas/agentic-assets-test/acmeasset">

  <xs:simpleType name="stringList">
    <xs:list itemType="xs:string" />
  </xs:simpleType>

  <xs:element name="channels" type="nxs:stringList" />

</xs:schema>
