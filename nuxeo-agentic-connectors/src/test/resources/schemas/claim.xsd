<?xml version="1.0"?>
<!-- A stand-in for a kit's claim schema, for the tests: the one property a connector keys on, and,
     for the webhooks' tests, a file and a complex property, which a webhook never sends. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:nxs="http://www.nuxeo.org/ecm/project/schemas/agentic-connectors-test/claim"
  targetNamespace="http://www.nuxeo.org/ecm/project/schemas/agentic-connectors-test/claim">

  <xs:element name="number" type="xs:string" />
  <xs:element name="scan" type="nxs:content" />
  <xs:element name="adjuster" type="nxs:adjuster" />

  <xs:complexType name="content">
    <xs:sequence>
      <xs:element name="encoding" type="xs:string" />
      <xs:element name="mime-type" type="xs:string" />
      <xs:element name="data" type="xs:base64Binary" />
      <xs:element name="name" type="xs:string" />
      <xs:element name="length" type="xs:long" />
      <xs:element name="digest" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="adjuster">
    <xs:sequence>
      <xs:element name="name" type="xs:string" />
      <xs:element name="phone" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

</xs:schema>
