<?xml version="1.0"?>
<component name="org.nuxeo.agentic.ui.authentication.contrib">

  <extension point="startURL"
             target="org.nuxeo.ecm.platform.ui.web.auth.service.PluggableAuthenticationService">
    <startURLPattern>
      <patterns>
        <pattern>agentic-ui</pattern>
      </patterns>
    </startURLPattern>
  </extension>

  <extension point="openUrl"
             target="org.nuxeo.ecm.platform.ui.web.auth.service.PluggableAuthenticationService">
    <openUrl name="agenticUIImages">
      <grantPattern>${org.nuxeo.ecm.contextPath}/agentic-ui/assets/.*</grantPattern>
    </openUrl>
  </extension>

  <!--
    The app registry, /agentic-ui-apps/, is read by the application after sign-in, as the REST API
    is, so it authenticates as the REST API does: the RestAPI chain's plugins (nuxeo-rest-api-server,
    OSGI-INF/auth-contrib.xml), whose basic authenticator answers 401 when a request does not
    authenticate, rather than the default chain's form, which would send the application a login
    page. A session cookie still authenticates, as it does on the REST API.

    Then ANONYMOUS_AUTH, last, as the default chain has it. It does nothing on a server that defines
    no anonymous user, where a request with no credentials stays 401. On one that defines one, such
    a request is Anonymous, who is in no app's group, and gets an empty list rather than a 401, as
    a deployment that lets anonymous visitors use the REST API would expect. The application ends
    no session on the registry's 401 either (APP_REGISTRY_REQUEST in libs/shared/app-registry);
    a client from before that does, and would sign an anonymous session out at startup.
  -->
  <extension point="specificChains"
             target="org.nuxeo.ecm.platform.ui.web.auth.service.PluggableAuthenticationService">
    <specificAuthenticationChain name="AgenticUiAppRegistry">
      <urlPatterns>
        <url>(.*)/agentic-ui-apps/.*</url>
      </urlPatterns>
      <replacementChain>
        <plugin>AUTOMATION_BASIC_AUTH</plugin>
        <plugin>TOKEN_AUTH</plugin>
        <plugin>OAUTH2_AUTH</plugin>
        <plugin>JWT_AUTH</plugin>
        <plugin>ANONYMOUS_AUTH</plugin>
      </replacementChain>
    </specificAuthenticationChain>
  </extension>

</component>
