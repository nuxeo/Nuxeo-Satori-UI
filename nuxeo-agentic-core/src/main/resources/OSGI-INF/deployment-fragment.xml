<?xml version="1.0"?>
<fragment version="1">

  <!-- Target the web template's FILTER-MAPPING marker, not the generated file path. -->
  <extension target="web#FILTER-MAPPING">
    <filter-mapping>
      <filter-name>NuxeoAuthenticationFilter</filter-name>
      <url-pattern>/agentic-ui/*</url-pattern>
      <dispatcher>REQUEST</dispatcher>
      <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
  </extension>

  <!--
    The packaged UI configuration, served from the configuration service. No authentication
    filter is mapped on /agentic-ui-config/*: the application reads it before sign-in. The
    servlet mapping is more specific than Tomcat's default servlet, so the servlet alone answers
    for this path; nothing on the server's disk under it is served.
  -->
  <extension target="web#SERVLET">
    <servlet>
      <servlet-name>Agentic UI Configuration</servlet-name>
      <servlet-class>org.nuxeo.agentic.config.AgenticUiConfigServlet</servlet-class>
    </servlet>
  </extension>

  <extension target="web#SERVLET-MAPPING">
    <servlet-mapping>
      <servlet-name>Agentic UI Configuration</servlet-name>
      <url-pattern>/agentic-ui-config/*</url-pattern>
    </servlet-mapping>
  </extension>

</fragment>
