<?xml version="1.0"?>
<component name="org.nuxeo.agentic.records.types" version="1.0">

  <documentation>
    The disposition review's document types. A repository has one DispositionRuns folder, made by an
    administrator, which holds every request a person files, every run, every certificate and every
    audit export. A person files a DispositionRequest or a RecordsAuditExport; runs and
    certificates are written by the add-on alone, and an export's files and figures too.

    The records a run reviews are the platform's retention module's (nuxeo-retention): a run reads
    its Record facet, record:ruleIds and record:retainUntil, and the rule's retention_def:endActions.
    This component requires the module's types, so that without the module none of these types is
    registered and the add-on does nothing.
  </documentation>

  <require>org.nuxeo.ecm.core.CoreExtensions</require>
  <require>org.nuxeo.retention.types</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="disposition_runs" prefix="druns" src="schemas/disposition_runs.xsd" />
    <schema name="disposition_run" prefix="drun" src="schemas/disposition_run.xsd" />
    <schema name="disposition_request" prefix="dreq" src="schemas/disposition_request.xsd" />
    <schema name="disposition_certificate" prefix="dcert" src="schemas/disposition_certificate.xsd" />
    <schema name="records_audit_export" prefix="rexp" src="schemas/records_audit_export.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <!-- No Versionable facet on any of them: a request, a run or a certificate is never checked in
         or restored to an earlier state. -->
    <doctype name="DispositionRuns" extends="Folder">
      <schema name="disposition_runs" />
      <subtypes>
        <type>DispositionRequest</type>
        <type>DispositionRun</type>
        <type>DispositionCertificate</type>
        <type>RecordsAuditExport</type>
      </subtypes>
    </doctype>

    <doctype name="DispositionRun" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="disposition_run" />
    </doctype>

    <doctype name="DispositionRequest" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="disposition_request" />
    </doctype>

    <doctype name="DispositionCertificate" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="file" />
      <schema name="disposition_certificate" />
    </doctype>

    <!-- An audit export: filed by a person with ExportRecordsAudit, written by the add-on. Its CSV
         is file:content, which the repository keeps once the export is made a record; its JSON the
         first of files:files, which the add-on keeps. -->
    <doctype name="RecordsAuditExport" extends="Document">
      <schema name="common" />
      <schema name="dublincore" />
      <schema name="file" />
      <schema name="files" />
      <schema name="records_audit_export" />
    </doctype>
  </extension>

</component>
