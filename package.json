{
  "name": "agentic-ui",
  "version": "0.0.0",
  "scripts": {
    "beta:api": "node scripts/beta-harness/api-surface.mjs",
    "beta:audit": "node scripts/beta-harness/assertion-audit.mjs",
    "beta:parity-surface": "node scripts/beta-harness/parity-surface-audit.mjs",
    "beta:parity-surface-selftest": "node scripts/beta-harness/parity-surface-audit.selftest.mjs",
    "beta:audit-selftest": "node scripts/beta-harness/assertion-audit.selftest.mjs",
    "beta:parity-selftest": "node scripts/beta-harness/steps/nxsat-308-parity.selftest.mjs",
    "beta:backend": "node scripts/beta-harness/backend-preflight.mjs",
    "beta:bundle": "node scripts/beta-harness/no-test-libs-in-bundle.mjs",
    "beta:coverage": "node scripts/beta-harness/coverage-gate.mjs",
    "beta:sanitizers": "node scripts/beta-harness/sanitizer-audit.mjs",
    "beta:sanitizers-selftest": "node scripts/beta-harness/sanitizer-audit.selftest.mjs",
    "beta:e2e": "npx tsx scripts/beta-harness/e2e-preflight.mjs && npx playwright test -c apps/nuxeo-ui-e2e/playwright.config.ts",
    "beta:e2e-preflight": "npx tsx scripts/beta-harness/e2e-preflight.mjs",
    "beta:e2e-negative-control": "./scripts/e2e-negative-control.sh",
    "beta:e2e-negative-control-selftest": "node scripts/beta-harness/assertion-reporter.selftest.mjs",
    "beta:e2e-vacuity-selftest": "node scripts/beta-harness/vacuity-verdict.selftest.mjs",
    "beta:integration": "npx tsx libs/integration-tests/src/preflight-cli.ts && npx vitest run --config libs/integration-tests/vitest.config.mts",
    "beta:integration-preflight": "npx tsx libs/integration-tests/src/preflight-cli.ts",
    "beta:customer-guardrails": "node libs/platform/guardrails/check-extension-library.mjs libs/extensions/acme-extensions && node scripts/check-extension-library.selftest.mjs",
    "beta:dependency-tree": "node scripts/beta-harness/dependency-tree.mjs",
    "beta:dependency-tree-selftest": "node scripts/beta-harness/dependency-tree.selftest.mjs",
    "beta:evidence": "node scripts/beta-harness/phase-runner.mjs",
    "beta:fork": "node scripts/beta-harness/fork-simulation.mjs",
    "beta:gate": "node scripts/beta-harness/verify-gate.mjs",
    "beta:gate-selftest": "node scripts/beta-harness/verify-gate.selftest.mjs",
    "beta:identity-guard-controls": "node scripts/beta-harness/identity-guard.controls.mjs",
    "beta:identity-guard-selftest": "node scripts/beta-harness/identity-guard.selftest.mjs",
    "beta:lockfile": "node scripts/beta-harness/lockfile-integrity.mjs",
    "beta:lockfile-selftest": "node scripts/beta-harness/lockfile-integrity.selftest.mjs",
    "beta:publishable": "node scripts/beta-harness/publishability.mjs",
    "beta:installable": "node scripts/beta-harness/peer-installability.mjs",
    "beta:reference": "node scripts/beta-harness/extension-reference-drift.mjs",
    "beta:slides": "node tools/video/export-pptx.mjs",
    "docs:diagrams": "node scripts/render-mermaid.mjs",
    "docs:publish": "node scripts/render-mermaid.mjs && node scripts/publish-confluence.mjs",
    "docs:verify": "node scripts/verify-confluence.mjs",
    "docs:links-selftest": "node scripts/confluence-links.selftest.mjs",
    "docs:storage-selftest": "node scripts/confluence-storage.selftest.mjs",
    "docs:satori-comparison:check": "node scripts/beta-harness/satori-comparison-doc.mjs",
    "docs:satori-comparison:selftest": "node scripts/beta-harness/satori-comparison-doc.selftest.mjs",
    "docs:satori-comparison:capture": "node scripts/satori-comparison/capture.mjs",
    "docs:satori-comparison:publish": "node scripts/satori-comparison/publish.mjs",
    "ci:registry-auth": "node scripts/registry-auth-check.mjs",
    "ci:registry-auth-selftest": "node scripts/registry-auth-check.selftest.mjs",
    "beta:state": "node scripts/beta-harness/state-check.mjs",
    "beta:upgrade": "node scripts/beta-harness/upgrade-rehearsal.mjs",
    "beta:sync-docs": "node scripts/sync-platform-docs.mjs",
    "sync:derived": "node scripts/sync-derived.mjs",
    "sync:derived-selftest": "node scripts/sync-derived.selftest.mjs",
    "build": "nx build",
    "config:dev": "node scripts/dev-config.mjs",
    "dev": "nx serve nuxeo-ui",
    "evidence:collect": "node scripts/collect-evidence/story-runner.mjs",
    "evidence:story": "node scripts/collect-evidence/story-report.mjs",
    "storybook:interactions": "node scripts/storybook-interactions.mjs",
    "storybook:publication-gate": "node scripts/storybook-publication-gate.mjs",
    "storybook:publication-gate-selftest": "node scripts/storybook-publication-gate.selftest.mjs",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "ng": "ng",
    "prepare": "husky",
    "review:guardrails": "node scripts/review-guardrails.mjs",
    "review:guardrails-selftest": "node scripts/review-guardrails.selftest.mjs",
    "review:preflight": "npm run review:guardrails && npm run review:guardrails-selftest && npm run beta:sanitizers && npm run beta:sanitizers-selftest && npx nx affected -t lint && npx nx affected -t test && npm run review:crowdin-selftest",
    "start": "nx serve",
    "test": "nx test",
    "watch": "nx build --watch --configuration development",
    "beta:supply-chain": "node scripts/beta-harness/supply-chain.mjs",
    "beta:code-scanning": "node scripts/beta-harness/code-scanning.mjs",
    "a11y": "node scripts/a11y-scan.mjs",
    "a11y:all": "node scripts/a11y-scan.mjs --all",
    "a11y:baseline": "node scripts/a11y-scan.mjs --update-baseline",
    "a11y:scan": "node a11y/run.mjs",
    "sonar:scan": "sonar-scanner",
    "sonar:scan:local": "npm run test -- --coverage && sonar-scanner",
    "review:pre-pr": "node scripts/pre-pr-review.mjs",
    "review:analysis": "node scripts/pr-review-analysis.mjs",
    "review:analysis-selftest": "node scripts/pr-review-analysis.selftest.mjs",
    "mirror:agents": "node scripts/mirror-agent-config.mjs sync",
    "beta:mirror": "node scripts/mirror-agent-config.mjs check",
    "i18n:pseudo": "node tools/i18n/pseudo-locale.mjs",
    "i18n:audit": "node tools/i18n/pseudo-locale.mjs && node tools/i18n/pseudo-locale-audit.mjs && node tools/i18n/pseudo-locale-deep.mjs",
    "review:crowdin-selftest": "node tools/i18n/crowdin-push-context.selftest.mjs && node tools/i18n/crowdin-status.selftest.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "20.x"
  },
