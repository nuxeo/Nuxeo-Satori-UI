<package type="addon" name="<%= name %>" version="<%= version %>">
  <title><%= title %></title>
  <description>
    <p>Nuxeo Satori configuration: bootstrap and manifest fragments contributed to org.nuxeo.agentic.ui.config.</p>
  </description>
  <vendor><%= vendor %></vendor>
  <installer restart="true" />
  <uninstaller restart="true" />
  <target-platform>
    <name>lts</name>
    <version>[2025.0,2026.0)</version>
  </target-platform>
  <dependencies>
    <package>nuxeo-agentic-ui:2026.0.2</package>
  </dependencies>
  <visibility>PRIVATE</visibility>
</package>
