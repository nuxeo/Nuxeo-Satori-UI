@if (heading().trim()) {
  @switch (headingLevel()) {
    @case (1) {
      <h1 class="nxs-<%= fileName %>__heading">{{ heading() }}</h1>
    }
    @case (3) {
      <h3 class="nxs-<%= fileName %>__heading">{{ heading() }}</h3>
    }
    @case (4) {
      <h4 class="nxs-<%= fileName %>__heading">{{ heading() }}</h4>
    }
    @case (5) {
      <h5 class="nxs-<%= fileName %>__heading">{{ heading() }}</h5>
    }
    @case (6) {
      <h6 class="nxs-<%= fileName %>__heading">{{ heading() }}</h6>
    }
    @default {
      <h2 class="nxs-<%= fileName %>__heading">{{ heading() }}</h2>
    }
  }
}<% if (isDocumentView) { %>
@if (document(); as doc) {
  <p class="nxs-<%= fileName %>__title">{{ doc.title }}</p>
}<% } %>
